,[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"locale\",\"dk\",\"d\"],[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/1029e7e837152b2c.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],\"$L4\"]}],{\"children\":[\"contact\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[\"$L5\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/6f38da81924774e7.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$L6\",null,{\"children\":[\"$L7\",[\"$\",\"$L8\",null,{\"promise\":\"$@9\"}]]}]]}],{},null,false]},null,false]},null,false]},null,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$La\",null,{\"children\":\"$Lb\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$Lc\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$d\",null,{\"fallback\":null,\"children\":\"$Le\"}]}]}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$f\",[]],\"s\":false,\"S\":true}\n10:I[7134,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"638\",\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\"],\"default\"]\n5:[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mx-auto text-center capitalize mb-4\",\"children\":\"Kontakt\"}],[\"$\",\"$L10\",null,{}]]\n11:I[944,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"SpeedInsights\"]\n12:I[3942,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"default\"]\n4:[\"$\",\"html\",null,{\"lang\":\"dk\",\"children\":[[\"$\",\"$L11\",null,{}],[\"$\",\"$d\",null,{\"fallback\":null,\"children\":[\"$\",\"$L12\",null,{\"GA_MEASUREMENT_ID\":\"G-0LCR929FXK\"}]}],[\"$\",\"body\",null,{\"className\":\"__variable_440f51 __variable_fb4fc1 __variable_454bfa __variable_5db66a __variable_f35245 antialiased flex min-h-screen selection:bg-(--primary) selection:text-(--selector-txt) \",\"children\":\"$L13\"}]]}]\n14:I[8353,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"638\",\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\"],\"default\"]\n13:[\"$\",\"$L14\",null,{\"formats\":\"$undefined\",\"locale\":\"dk\",\"messages\":{\"about\":{\"image\":\"/images/Lensa/Lensa2.webp\",\"paragraph1\":\"De sidste to år har jeg bygget ting på nettet. Men mit perspektiv på hvad der skal bygges, og hvorfor, blev formet længe før jeg skrev min første linje kode.\",\"paragraph2\":\"Jeg kom ind i dette felt fra marketing, men ikke den side du måske forestiller dig. Min verden handlede mindre om kampagner og mere om mønstre: analysering af markedets data, afkodning af brugeradfærd og forståelse af de præcise mekanismer for hvordan folk finder og bruger et produkt online. SEO og SEM er i deres kerne blot anvendt psykologi og problemløsning. Du lærer at lytte til hvad dataen skriger, og endnu vigtigere, til hvad den hvisker.\",\"paragraph3\":\"Det er den baggrund jeg bringer med til hvert udviklingsprojekt. De fleste udviklere kan skrive elegant kode; mit fokus er på at bygge elegante løsninger. Der er en afgørende forskel.\",\"paragraph4\":\"Når jeg arkitektere en applikation med React eller Next.js, tænker jeg ikke kun på statushåndtering eller komponentstruktur. Jeg tænker på brugerens rejse der bragte dem dertil. Jeg overvejer den semantiske markup som giver vores indhold mening ud over skærmen. Jeg bygger med en indfødt forståelse af ydeevne fordi jeg ved af førstehåndserfaring, at en forsinkelse på bare et halvt sekund er en beslutning en bruger tager om at forlade siden.\",\"paragraph5\":\"Her er hvad mange talentfulde udviklere tager fejl af: de bygger til enheden. De bygger efter specifikationen. Men de glemmer at bygge for mennesket på den anden side, og for den forretningsmæssige objektiv der gør projektet værd at lave. Min erfaring gør mig i stand til at sidde i det krydsfelt. Jeg kan oversætte et forretningsbehov til et teknisk krav ikke som et abstrakt koncept, men som en erfaret virkelighed. Jeg har været personen som bad om dataen, og nu er jeg personen som bygger systemerne der leverer den.\",\"paragraph6\":\"Uanset om det er en sleek front-end, en robust Django admin, eller en fuldstack Node.js applikation, er det spørgsmål jeg altid starter med: \\\"Hvad løser vi egentlig?\\\" Teknologien er et middel til et mål. Det virkelige håndværk ligger i at vælge det rigtige værktøj til opgaven og bruge det med visdommen af at vide hvad opgaven virkelig går ud på.\",\"paragraph7\":\"Jeg bygger ikke kun tingene rigtigt. Jeg bygger de rigtige ting.\",\"title1\":\"Bygger til mennesket bag skærmen\"},\"carousel\":[{\"alt\":\"Revolutioner Dit Digitale Nærvær Nu!\",\"cta\":\"Revolutioner Dit Digitale Nærvær!\",\"description\":\"Holder din hjemmeside din virksomhed tilbage? Vores omfattende performanceaudit graver dybt ned i din sites tekniske infrastruktur, brugeroplevelse og konverteringspotentiale. Vi leverer en detaljeret rapport der fremhæver kritiske forbedringer som kan booste din online performance dramatisk.\",\"id\":1,\"imageUrl\":\"/images/Carousel/white.webp\",\"loading\":\"lazy\",\"title\":\"revolutioner dit digitale nærvær nu!\",\"url\":\"/contact\"},{\"alt\":\"Lås Din Hjemmesides Fuld Potentiale Op\",\"cta\":\"Lås Din Hjemmesides Fuld Potentiale Op\",\"description\":\"Hjemmesider kræver konsekvent pleje for at forblive sikre, funktionelle og konkurrencedygtige. Vores omfattende vedligeholdelsespakker giver proaktiv overvågning, øjeblikkelig fejlretning og kontinuerlige teknologiopdateringer.\",\"id\":2,\"imageUrl\":\"/images/Carousel/umbrellas.webp\",\"loading\":\"eager\",\"title\":\"lås din hjemmesides fulde potentiale op\",\"url\":\"/contact\"},{\"alt\":\"Byg Dit Drømmeprojekt I Dag\",\"cta\":\"Byg Dit Drømmeprojekt I Dag\",\"description\":\"Stop med at nøjes med generiske skabeloner. Vores skræddersyede webudviklingstjenester skaber fuldt tilpassede digitale oplevelser der perfekt matcher din brands unikke identitet og forretningsmål. Vi omdanner dit koncept til en kraftfuld, responsiv og banebrydende webløsning.\",\"id\":3,\"imageUrl\":\"/images/Carousel/estatuas.webp\",\"loading\":\"eager\",\"title\":\"bygg dit drømmeprojekt i dag\",\"url\":\"/contact\"},{\"alt\":\"Tag Det Første Skridt Mod Digital Ekspertise\",\"cta\":\"Tag Det Første Skridt\",\"description\":\"Hastighed er ikke kun en funktion—det er en konkurrencefordel. Vores performanceoptimeringstjeneste sikrer at din hjemmeside load lynhurtigt, hvilket giver en enestående brugeroplevelse der fastholder besøgende og konverterer mere effektivt.\",\"id\":4,\"imageUrl\":\"/images/Carousel/building-orange.webp\",\"loading\":\"eager\",\"title\":\"accellerer din hjemmesides potentiale\",\"url\":\"/contact\"},{\"alt\":\"Moderniser Din Digitale Infrastruktur\",\"cta\":\"Moderniser Din Digitale Infrastruktur\",\"description\":\"Teknologien udvikler sig hurtigt. Vores ekspertmigrationstjenester hjælper dig med at skifte problemfrit til moderne, effektive webteknologier uden at forstyrre din eksisterende drift. Vi sikrer en glat, risikostyret opgraderingsvej.\",\"id\":5,\"imageUrl\":\"/images/Carousel/building-yellow.webp\",\"loading\":\"eager\",\"title\":\"moderniser din digitale infrastruktur\",\"url\":\"/contact\"},{\"alt\":\"blyanter\",\"cta\":\"sørg for dine digitale aktiver\",\"description\":\"Hjemmesider kræver konsekvent pleje for at forblive sikre, funktionelle og konkurrencedygtige. Vores omfattende vedligeholdelsespakker giver proaktiv overvågning, øjeblikkelig fejlretning og kontinuerlige teknologiopdateringer.\",\"id\":6,\"imageUrl\":\"/images/Carousel/pencils.webp\",\"loading\":\"lazy\",\"title\":\"kontinuerlig pleje for dine digitale aktiver\",\"url\":\"/contact\"}],\"contact\":{\"btn\":\"send besked\",\"email\":\"e-mail\",\"farewell\":{\"text\":\"Jeg sætter pris på din tillid. Du kan forvente et svar inden for de næste hverdage.\",\"title\":\"tak\"},\"firstName\":\"fornavn\",\"label\":\"Jeg har læst og accepterer \",\"lastName\":\"efternavn\",\"message\":\"besked\",\"pageTitle\":\"Kontakt\",\"phone\":\"telefonnummer\",\"placeholder\":{\"email\":\"Indtast din e-mail\",\"firstName\":\"Indtast dit fornavn\",\"lastName\":\"Indtast dit efternavn\",\"message\":\"Indtast din besked\",\"phone\":\"Indtast dit telefonnummer\"},\"privacy\":\"privatlivspolitik\",\"privacyPolicyCheck\":\"Jeg bekræfter at jeg har læst og accepterer\",\"privacyPolicyUrl\":\"privacy-policy/\",\"privacyPolicyUrlAriaDetails\":\"Privatlivspolitik\",\"privacyPolicyUrlAriaLabel\":\"Privatlivspolitik\",\"privacyPolicyUrlTitle\":\"Privatlivspolitik\",\"required\":\"påkrævet\",\"title\":\"kom i kontakt\"},\"cookies\":{\"buttonText\":\"Acceptér Alle\",\"declineButtonText\":\"Afvis Alle\",\"manageAdvertSubtitle\":\"Tilpas annoncer og mål deres performance\",\"manageAdvertTitle\":\"Reklame\",\"manageAnalyticsSubtitle\":\"Hjælp os med at forstå hvordan besøgende interagerer med vores hjemmeside\",\"manageAnalyticsTitle\":\"Analyser\",\"manageButtonText\":\"Administrer Cookies\",\"manageCancelButtonText\":\"Annuller\",\"manageCookiesStatus\":\"Status: {{status}} den {{date}}\",\"manageCookiesStatusConsented\":\"Accepteret\",\"manageCookiesStatusDeclined\":\"Afvist\",\"manageEssentialStatus\":\"Status: Altid aktiveret\",\"manageEssentialStatusButtonText\":\"Analyser\",\"manageEssentialSubtitle\":\"Nødvendig for at hjemmesiden fungerer korrekt\",\"manageEssentialTitle\":\"Essentiel\",\"manageMessage\":\"Administrer dine cookie-præferencer nedenfor. Essentielle cookies er altid aktiveret da de er nødvendige for at hjemmesiden skal fungere korrekt.\",\"manageSaveButtonText\":\"Gem Præferencer\",\"manageSocialSubtitle\":\"Aktiver sociale medie-funktioner og deling\",\"manageSocialTitle\":\"Socialt\",\"manageTitle\":\"Cookie Præferencer\",\"message\":\"Vi værdsætter dit privatliv. Vælg hvilke cookies du vil tillade. Essentielle cookies er altid aktiveret da de er nødvendige for at hjemmesiden skal fungere korrekt.\",\"privacyPolicyText\":\"Privatlivspolitik\",\"privacyurl\":\"/dk/privacy-policy\",\"title\":\"Kunne Du Tænke Dig En Småkage? 🍪\"},\"cta\":{\"blurb\":\"Har du et projekt i tankerne? Lad os tale sammen.\",\"button\":[\"Lad os tale om din virksomhed\",\"Har du et projekt i tankerne? Lad os snakke.\",\"Leder du efter en Front-End Udvikler? Du Har Fundet En!\",\"Sig Hej — Jeg Bider Ikke 👋\",\"Lad Os Gøre Din Hjemmeside Uglemnelig →\",\"Har du brug for en udvikler der leverer? Lad os tale sammen.\",\"Lad Os Bygge Noget Fantastisk Sammen →\"],\"title\":\"kom i kontakt\"},\"email\":{\"email\":\"hello@daniel-freire.com\",\"message\":\"tilfældig besked\",\"title\":\"💻🚀 Hej\",\"welcome\":{\"conclusion\":\"Dette er mere end en hjemmeside—det er dit digitale håndtryk, dit første indtryk, og din mulighed for at skille dig ud i et overfyldt marked. Lad os gøre det uforglemmeligt.\",\"happensNext0\":\"Her er hvad der sker nu:\",\"happensNext1\":\"Jeg vil personligt gennemgå din henvendelse og svare med en tilpasset plan (eller eventuelle spørgsmål for at præcisere omfanget) inden for 2-3 hverdage.\",\"happensNext2\":\"I løbet af de næste hverdage hører du fra mig med klare næste skridt, tidsplaner og hvordan vi vil samarbejde om at få din vision til virkelighed.\",\"happensNext3\":\"Hvis du ikke har modtaget min e-mail inden da, er du velkommen til at følge op—jeg er enten dybt forddybet i kode eller kæmper med min indbakke (og jeg vil altid prioritere dit projekt).\",\"heading\":\"Hej\",\"intro\":\"Lad os starte med en simpel sandhed: at bygge et online nærvær som virkelig repræsenterer dine services/kompetencer som professionel kræver mod og vision. At du er her—og tager konkrete skridt for at forbedre dit arbejde—vidner meget om din engagement for vækst. Det er værd at fejre.\",\"introduction\":\"Jeg er Daniel Freire, og jeg specialiserer mig i at skabe højimpact, kunde-fokuserede hjemmesider der ikke blot viser projekter, men fortæller en overbevisende historie om hvad du bringer til bordet. Uanset om du sigter efter at tiltrække topkvalitets kunder, lande dit drømmejob eller blot vise dine kompetencer med klarhed og stil, er din hjemmeside dit mest kraftfulde værktøj. Og jeg er her for at hjælpe dig med at gøre det skarpere.\",\"name\":\"Daniel Freire\",\"preview\":\"Daniel Freires Velkomst-e-mail\",\"privacyPolicy\":\"privatlivspolitik\",\"privacyPolicyUrl\":\"dk/privacy-policy/\",\"signature\":\"Ser frem til at arbejde sammen med dig,\",\"view\":\"Se\",\"webLink\":\"daniel-freire.com\",\"whileWait0\":\"Mens du venter, kan du frit:\",\"whileWait1\":\"✅ Besvar denne e-mail med yderligere tanker—som specifikke projekter du er stolt af, designpræferencer eller mål for din hjemmeside (f.eks. \\\"Jeg vil ha at rekruttere skal øjeblikkeligt se min fuldstack ekspertise\\\"). \",\"whileWait2\":\"✅ Saml aktiver (GitHub-links, casestudier eller endnu grove skitser) for at strømline processen når vi begynder.\"}},\"error\":{\"404\":\"404 - siden blev ikke fundet\",\"back\":\"Gå tilbage til forsiden\",\"description\":\"Det ser ud til at du er faret vild. Bare rolig, det sker for de bedste.\",\"errorLoading\":{\"contact\":\"<p>Hvis du tror der burde være en side her, kontakt venligst <a>webmaster@daniel-freire.com</a></p>\",\"description\":\"<p>Vi har desværre stødt på en fejl.</p><p>Du kan prøve at <retry>genindlæse siden</retry> du besøgte.</p>\",\"title\":\"noget gik galt!\"}},\"home\":{\"techstack\":\"Færdigheder & Værktøjer\",\"trending\":\"Portfolio\"},\"icons\":{\"leftarrow\":{\"alt\":\"venstre pil\",\"src\":\"/images/icons/chevron-left.svg\"},\"rightarrow\":{\"alt\":\"højre pil\",\"src\":\"/images/icons/chevron-right.svg\"}},\"localeSwitcher\":{\"locale\":\"{locale, select, pt {🇵🇹 Português} en {🇺🇸 English} dk {🇩🇰 Dansk} pl {🇵🇱 Polski} de {🇩🇪 Deutsch} cz {🇨🇿 Český} other {Unknown}}\",\"localeMobile\":\"{locale, select, pt {🇵🇹} en {🇺🇸} dk {🇩🇰} pl {🇵🇱} de {🇩🇪} cz {🇨🇿} other {Unknown}}\"},\"metadata\":{\"description\":{\"about\":\"Lær mere om Daniel\",\"contact\":\"Dette er det bedste sted at kontakte Daniel\",\"home\":\"Daniels introduktion\",\"impressum\":\"\",\"portfolio\":\"Dette er hvor Daniel vil offentliggøre hans yndlingsarbejde\",\"privacyPolicy\":\"Find ud af mere om dine rettigheder.\"},\"name\":\"Daniel Freire\",\"opengraphImage\":\"metadata/open-graph.png\",\"opengraphImageAlt\":\"Daniel Freire\",\"title\":{\"about\":\"Om\",\"contact\":\"Kontakt\",\"home\":\"Forside | Daniel Freire\",\"impressum\":\"Impressum\",\"portfolio\":\"Portfolio\",\"privacyPolicy\":\"Privatlivspolitik\"},\"twitterImage\":\"metadata/open-graph.png\",\"twitterImageAlt\":\"Daniel Freire\"},\"portfolio\":{\"all\":\"Alle\",\"cta\":[\"tjek det ud\",\"se det live projekt →\"],\"pageTitle\":\"portfolio\",\"projects\":[{\"demo\":\"Demo\",\"github\":\"https://github.com/danielfreire-dev/Quizzical\",\"link\":\"https://quizzicall-bydainelli.netlify.app/\",\"src\":\"/images/screenshots/quizzical.webp\",\"summary\":\"Trivia game with 4.000+ questions.\",\"title\":\"quizzical\"},{\"demo\":\"Demo\",\"github\":\"https://github.com/danielfreire-dev/PollyGlot\",\"link\":\"https://pollyglot-bydainelli.netlify.app/\",\"src\":\"/images/screenshots/pollyglot.webp\",\"summary\":\"Translation app with AI.\",\"title\":\"pollyGlot\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://danielfreire.pages.dev/Miscellanea/DrumKit/\",\"src\":\"/images/screenshots/drumsVeryBig1920.webp\",\"summary\":\"Fun project to reproduce a Drum Kit in your PC.\",\"title\":\"drum kit app\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://tenzi-bydaniel.netlify.app/\",\"src\":\"/images/screenshots/Tenzi.webp\",\"summary\":\"The world's most popular dice game, now in your browser.\",\"title\":\"tenzi\"}],\"projects-title\":\"Projects\",\"websites\":[{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://muraryu.com\",\"src\":\"/images/screenshots/muraryu.webp\",\"summary\":\"MuraRyu is a new Condominium Management company in Portugal.\",\"title\":\"muraRyu\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://victo.pages.dev\",\"src\":\"/images/screenshots/victo.webp\",\"summary\":\"Gallery website built to showcase the works of the famous Portuguese artist Victó.\",\"title\":\"victó's art gallery\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://insurbia.com\",\"src\":\"/images/screenshots/insurbia2.webp\",\"summary\":\"Website developed to be be contact point for the arquitecture collective Insurbia.\",\"title\":\"insurbia\"}],\"websites-title\":\"Hjemmesider\"},\"privacyPolicy\":{\"contactEmail\":\"gdpr@daniel-freire.com\",\"header1\":\"1. Introduktion\",\"header10\":\"10. Opdateringer Til Denne Privatlivspolitik\",\"header11\":\"11. Kontakt Os\",\"header2\":\"2. Oplysninger Vi Indsamler\",\"header3\":\"3. Formål Med Dataindsamling\",\"header4\":\"4. Retsgrundlag For Behandling\",\"header5\":\"5. Videregivelse Af Personoplysninger\",\"header6\":\"6. Opbevaring Af Data\",\"header7\":\"7. Dine Rettigheder\",\"header8\":\"8. Datasikkerhed\",\"header9\":\"9. Klager\",\"paragraph1\":\"Velkommen til Daniel Freires hjemmeside. Vi er forpligtet til at beskytte dine personlige oplysninger og din ret til privatliv. Hvis du har spørgsmål eller bekymringer om denne privatlivspolitik eller vores praksis i forhold til dine personoplysninger, kontakt os venligst på\",\"paragraph10\":\"Vi kan opdatere denne privatlivspolitik fra tid til anden. Vi vil underrette dig om eventuelle ændringer ved at offentliggøre den nye privatlivspolitik på denne side.\",\"paragraph11\":\"Hvis du har spørgsmål om denne privatlivspolitik, kontakt os venligst på\",\"paragraph2\":\"Vi indsamler personlige oplysninger som du frivilligt giver os når du udfylder en formular på vores hjemmeside. De personlige oplysninger vi indsamler inkluderer:\",\"paragraph2li\":[\"Fornavn\",\"Efternavn\",\"E-mail adresse\",\"Telefonnummer\"],\"paragraph3\":\"De oplysninger vi indsamler vil blive brugt til at kontakte dig i fremtiden. Vi vil kun bruge dine personlige data til dette specifikke formål.\",\"paragraph4\":\"Vi behandler dine personlige data baseret på dit samtykke, som du giver ved at udfylde formularen på vores hjemmeside.\",\"paragraph5\":\"Vi deler ikke dine personlige data med tredjeparter medmindre det er påkrævet af loven.\",\"paragraph6\":\"Vi vil opbevare dine personlige data kun så længe som nødvendigt for at opfylde formålene vi indsamlede dem til, inklusive for at tilfredsstille eventuelle juridiske krav.\",\"paragraph7\":\"Du har ret til at:\",\"paragraph7li\":[\"Få adgang til dine personlige data\",\"Anmode om rettelse af dine personlige data\",\"Anmode om sletning af dine personlige data\",\"Gøre indsigelse mod behandling af dine personlige data\",\"Anmode om begrænsning af behandlingen af dine personlige data\",\"Anmode om overførsel af dine personlige data\",\"Trække dit samtykke tilbage til enhver tid\"],\"paragraph8\":\"Vi implementerer passende tekniske og organisatoriske foranstaltninger for at sikre et niveau af sikkerhed som passer til risikoniveauet ved behandlingen af dine personlige data.\",\"paragraph9\":\"Hvis du mener at vi ikke har overholdt databeskyttelseslovene, har du ret til at indgive en klage til den relevante tilsynsmyndighed.\",\"title\":\"Privatlivspolitik for Daniel Freires Hjemmeside\"},\"services\":[{\"icon\":\"/images/icons/business-processes.svg\",\"text\":\"Skræddersyede webapplikationer — CRM-systemer, dashboards og interne værktøjer, der passer til din virksomheds måde at arbejde på.\",\"title\":\"Skræddersyet Forretningssoftware\"},{\"icon\":\"/images/icons/ai-recommend.svg\",\"text\":\"Integration af AI i dine arbejdsgange — chatbots, intelligent automatisering og datadrevne funktioner.\",\"title\":\"Implementering af AI-løsninger\"},{\"icon\":\"/images/icons/dns-services.svg\",\"text\":\"Moderne, effektive websites og applikationer bygget med React, Next.js og TypeScript.\",\"title\":\"Webudvikling\"},{\"icon\":\"/images/icons/ibm-watson--machine-learning.svg\",\"text\":\"Databaserede audits, ydelsesoptimering og strategi til at hjælpe din virksomhed med at blive fundet.\",\"title\":\"SEO & Teknisk Rådgivning\"}],\"sidenav\":{\"footer\":{\"blurb\":\"Lavet med 🐞 af\",\"icons\":{\"github\":{\"alt\":\"GitHub\",\"ariaDetails\":\"Daniel Freires GitHub\",\"ariaLAbel\":\"Daniel Freires GitHub\",\"link\":\"https://github.com/danielfreire-dev/\",\"src\":\"/images/icons/github-square.svg\",\"title\":\"Daniel Freires GitHub\"},\"linkedin\":{\"alt\":\"LinkedIn\",\"ariaDetails\":\"Daniel Freires Linkedin\",\"ariaLAbel\":\"Daniel Freires Linkedin\",\"link\":\"https://www.linkedin.com/in/danielfreire-swe/\",\"src\":\"/images/icons/linkedin.svg\",\"title\":\"Daniel Freires Linkedin\"}}},\"header\":{\"role\":\"webudvikler\",\"title\":\"daniel freire\"},\"legal\":{\"impressumLink\":\"/impressum\",\"impressumName\":\"impressum\",\"privacyLink\":\"/privacy-policy\",\"privacyLinkAriaDetails\":\"Privatlivspolitik\",\"privacyLinkAriaLabel\":\"Privatlivspolitik\",\"privacyLinkTitle\":\"Privatlivspolitik\",\"privacyName\":\"privatlivspolitik\"},\"links\":[{\"link\":\"/\",\"name\":\"hjem\"},{\"link\":\"/about\",\"name\":\"om\"},{\"link\":\"/portfolio\",\"name\":\"portfolio\"},{\"link\":\"/contact\",\"name\":\"kontakt\"}],\"privacy\":\"privatlivspolitik\",\"rights\":\"Daniel Freire ® alle rettigheder forbeholdt\",\"select\":{\"languageSelectAriaLabel\":\"Vælg Sprog Menu\",\"languageSelectTitle\":\"Vælg Sprog Menu\"}},\"tech\":[{\"link\":\"https://nextjs.org\",\"logo\":\"/images/icons/nextjs-13.svg\",\"name\":\"next.js\",\"svgr\":\"Nextjs\"},{\"link\":\"https://react.dev\",\"logo\":\"/images/icons/react2.svg\",\"name\":\"react.js\",\"svgr\":\"Reactjs\"},{\"link\":\"https://nodejs.org/en\",\"logo\":\"/images/icons/node-js.svg\",\"name\":\"node.js\",\"svgr\":\"Nodejs\"},{\"link\":\"https://www.typescriptlang.org\",\"logo\":\"/images/icons/Typescript.svg\",\"name\":\"typeScript\",\"svgr\":\"TypeScript\"},{\"link\":\"https://developer.mozilla.org/en-US/docs/Web/JavaScript\",\"logo\":\"/images/icons/javascript-original.svg\",\"name\":\"javaScript\",\"svgr\":\"JavaScript\"},{\"link\":\"https://www.w3.org/html/\",\"logo\":\"/images/icons/html5-original-wordmark.svg\",\"name\":\"HTML5\",\"svgr\":\"HTML5\"},{\"link\":\"https://developer.mozilla.org/en-US/docs/Web/CSS\",\"logo\":\"/images/icons/Official_CSS_Logo.svg\",\"name\":\"CSS3\",\"svgr\":\"CSS3\"},{\"link\":\"https://www.postgresql.org\",\"logo\":\"/images/icons/postgresql.svg\",\"name\":\"postgreSQL\",\"svgr\":\"PostgreSQL\"},{\"link\":\"https://vite.dev\",\"logo\":\"/images/icons/vitejs.svg\",\"name\":\"vite.js\",\"svgr\":\"Vitejs\"},{\"link\":\"https://webpack.js.org/\",\"logo\":\"/images/icons/webpack.svg\",\"name\":\"webpack\",\"svgr\":\"Webpack\"},{\"link\":\"https://github.com/\",\"logo\":\"/images/icons/github.svg\",\"name\":\"gitHub\",\"svgr\":\"Github\"},{\"link\":\"https://git-scm.com/\",\"logo\":\"/images/icons/git-scm-icon.svg\",\"name\":\"git\",\"svgr\":\"Git\"},{\"link\":\"https://vitest.dev/\",\"logo\":\"/images/icons/vitest.svg\",\"name\":\"vitest\",\"svgr\":\"Vitest\"},{\"link\":\"https://jestjs.io/\",\"logo\":\"/images/icons/jestjsio-icon.svg\",\"name\":\"jest\",\"svgr\":\"Jest\"},{\"link\":\"https://selenium-python.readthedocs.io/\",\"logo\":\"/images/icons/selenium.svg\",\"name\":\"selenium\",\"svgr\":\"Selenium\"},{\"link\":\"https://www.python.org/\",\"logo\":\"/images/icons/python-original.svg\",\"name\":\"python\",\"svgr\":\"Python\"},{\"link\":\"https://www.linux.org/\",\"logo\":\"/images/icons/linux-original.svg\",\"name\":\"linux\",\"svgr\":\"Linux\"}],\"topMainPage\":{\"blurbsArray\":[{\"description\":\"Bremst Ihre Website Ihr Geschäftswachstum aus? Unser umfassender Performance-Audit analysiert tiefgehend Ihre technische Infrastruktur, Benutzererfahrung und Ihr Conversion-Potenzial. Wir liefern Ihnen einen detaillierten Bericht mit entscheidenden Verbesserungen, die Ihre Online-Performance dramatisch steigern können.\",\"title\":\"Revolutionieren Sie jetzt Ihre digitale Präsenz!\"},{\"description\":\"Websites benötigen ständige Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problemlösung und kontinuierliche technologische Updates.\",\"title\":\"Schöpfen Sie das volle Potenzial Ihrer Website aus\"},{\"description\":\"Geben Sie sich nicht länger mit generischen Vorlagen zufrieden. Unsere maßgeschneiderten Webentwicklungsdienste schaffen vollständig angepasste digitale Erlebnisse, die perfekt mit der einzigartigen Identität Ihrer Marke und Ihren Geschäftszielen übereinstimmen. Wir verwandeln Ihr Konzept in eine leistungsstarke, responsive und zukunftsweisende Weblösung.\",\"title\":\"Verwirklichen Sie noch heute Ihr Traumprojekt\"},{\"description\":\"Geschwindigkeit ist nicht nur ein Feature – sie ist ein Wettbewerbsvorteil. Unser Service zur Leistungsoptimierung sorgt für extrem schnelles Laden Ihrer Website und bietet eine außergewöhnliche Benutzererfahrung, die Besucher bindet und effektiver zu Konversionen führt.\",\"title\":\"Beschleunigen Sie das Potenzial Ihrer Website\"},{\"description\":\"Die Technologie entwickelt sich rasant weiter. Unsere spezialisierten Migrationsdienste helfen Ihnen beim nahtlosen Übergang zu modernen, effizienten Webtechnologien, ohne Ihren laufenden Betrieb zu stören. Wir gewährleisten einen reibungslosen, risikomanagerten Upgrade-Pfad.\",\"title\":\"Modernisieren Sie Ihre digitale Infrastruktur\"},{\"description\":\"Websites benötigen ständige Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problemlösung und kontinuierliche technologische Updates.\",\"title\":\"Laufende Betreuung Ihrer digitalen Assets\"}],\"p1\":\"Haben Sie es satt, dass Software Ihr Geschäft ausbremst?\",\"p2\":\"Die meisten Geschäftsanwendungen sind entweder zu starr oder zu komplex. Ich spezialisiere mich auf die Entwicklung maßgeschneiderter Webanwendungen – wie CRM-Systeme, Projekt-Tracker und Daten-Dashboards – die genau zu Ihrer tatsächlichen Arbeitsweise passen. Wenn Sie ein Werkzeug benötigen, das ein bestimmtes Problem ohne überflüssige Funktionen löst, sprechen wir darüber, was Sie erreichen möchten.\"}},\"now\":\"$undefined\",\"timeZone\":\"Europe/Lisbon\",\"children\":\"$L15\"}]\n16:I[59,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"Providers\"]\n17:I[5564,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"default\"]\n18:I[4275,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"530\",\"static/chunks/app/%5Blocale%5D/error-8ecce493219f8816.js\"],\"default\"]\n15:[\"$\",\"$L16\",null,{\"children\":[[\"$\",\"header\",null,{\"className\":\"flex flex-row\",\"children\":[\"$\",\"$L17\",null,{}]}],[\"$\",\"main\",null,{\"className\":\"flex flex-1 justify-center flex-col overflow-hidden pb-5 mt-9\",\"children\":[\"$\",\"div\",null,{\"id\":\"main\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$18\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]]}]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n7:null\n19:I[3407,[],\"IconMark\"]\n9:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Kontakt | Daniel Freire\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Dette er det bedste sted at kontakte Daniel\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://daniel-freire.com/\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Daniel Freire\"}],[\"$\",\"link\",\"4\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"5\",{\"name\":\"keywords\",\"content\":\"Daniel Freire,Portfolio,Next.js,React,TypeScript,JavaScript,Digital Marketing\"}],[\"$\",\"meta\",\"6\",{\"name\":\"creator\",\"content\":\"Daniel Freire\"}],[\"$\",\"link\",\"7\",{\"rel\":\"canonical\",\"href\":\"https://daniel-freire.com/contact\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://daniel-freire.com/en/contact\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"hrefLang\":\"pt\",\"href\":\"https://daniel-freire.com/pt/contactos\"}],[\"$\",\"meta\",\"10\",{\"name\":\"format-detection\",\"content\":\"telephone=no, address=no, email=no\"}],[\"$\",