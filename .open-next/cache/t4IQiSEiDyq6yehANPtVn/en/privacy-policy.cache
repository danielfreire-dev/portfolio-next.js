\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"21\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://daniel-freire.com/metadata/open-graph-initials5.png\\\"}],[\\\"$\\\",\\\"link\\\",\\\"22\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"242x242\\\"}],[\\\"$\\\",\\\"$L18\\\",\\\"23\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:\\\"$9:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[819,[],\"\"]\n3:I[4271,[],\"\"]\n6:I[7514,[],\"OutletBoundary\"]\n8:I[4751,[],\"AsyncMetadataOutlet\"]\na:I[7514,[],\"ViewportBoundary\"]\nc:I[7514,[],\"MetadataBoundary\"]\nd:\"$Sreact.suspense\"\nf:I[5865,[],\"\"]\n:HL[\"/_next/static/media/03734ca0d655c7fc-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/91b5bf6d44e5eed0-s.p.ttf\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/ttf\"}]\n:HL[\"/_next/static/media/b1d4c8157d89bfd7-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/dc3a3570e46a7698-s.p.ttf\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/ttf\"}]\n:HL[\"/_next/static/css/1029e7e837152b2c.css\",\"style\"]\n0:{\"P\":null,\"b\":\"t4IQiSEiDyq6yehANPtVn\",\"p\":\"\",\"c\":[\"\",\"en\",\"privacy-policy\"],\"i\":false,\"f\":[[[\"\",{\"children\":[[\"locale\",\"en\",\"d\"],{\"children\":[\"(legal)\",{\"children\":[\"privacy-policy\",{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true]}],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"locale\",\"en\",\"d\"],[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/1029e7e837152b2c.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],\"$L4\"]}],{\"children\":[\"(legal)\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"privacy-policy\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[\"$L5\",null,[\"$\",\"$L6\",null,{\"children\":[\"$L7\",[\"$\",\"$L8\",null,{\"promise\":\"$@9\"}]]}]]}],{},null,false]},null,false]},null,false]},null,false]},null,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$La\",null,{\"children\":\"$Lb\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$Lc\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$d\",null,{\"fallback\":null,\"children\":\"$Le\"}]}]}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$f\",[]],\"s\":false,\"S\":true}\n5:[\"$\",\"section\",null,{\"className\":\"m-7\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Privacy Policy for Daniel Freire's Website\"}],[\"$\",\"h3\",null,{\"children\":\"1. Introduction\"}],[\"$\",\"p\",null,{\"children\":[\"Welcome to Daniel Freire's website. We are committed to protecting your personal information and your right to privacy. If you have any questions or concerns about this privacy notice or our practices with regard to your personal information, please contact us at\",\" \",[\"$\",\"a\",null,{\"href\":\"mailto:gdpr@daniel-freire.com\",\"children\":\"gdpr@daniel-freire.com\"}],\".\"]}],[\"$\",\"h3\",null,{\"children\":\"2. Information We Collect\"}],[\"$\",\"p\",null,{\"children\":\"We collect personal information that you voluntarily provide to us when you fill out a form on our website. The personal information we collect includes:\"}],[\"$\",\"ul\",null,{\"className\":\"pl-2 list-inside list-disc\",\"children\":[[\"$\",\"li\",\"First name\",{\"children\":\"First name\"}],[\"$\",\"li\",\"Last name\",{\"children\":\"Last name\"}],[\"$\",\"li\",\"Email address\",{\"children\":\"Email address\"}],[\"$\",\"li\",\"Phone number\",{\"children\":\"Phone number\"}]]}],[\"$\",\"h3\",null,{\"children\":\"3. Purpose of Data Collection\"}],[\"$\",\"p\",null,{\"children\":\"The information we collect will be used to contact you in the future. We will only use your personal data for this specific purpose.\"}],[\"$\",\"h3\",null,{\"children\":\"4. Legal Basis for Processing\"}],[\"$\",\"p\",null,{\"children\":\"We process your personal data based on your consent, which you provide by filling out the form on our website.\"}],[\"$\",\"h3\",null,{\"children\":\"5. Sharing of Personal Data\"}],[\"$\",\"p\",null,{\"children\":\"We do not share your personal data with third parties except as required by law.\"}],[\"$\",\"h3\",null,{\"children\":\"6. Data Retention\"}],[\"$\",\"p\",null,{\"children\":\"We will retain your personal data only for as long as necessary to fulfill the purposes we collected it for, including for the purposes of satisfying any legal requirements.\"}],[\"$\",\"h3\",null,{\"children\":\"7. Your Rights\"}],[\"$\",\"p\",null,{\"children\":\"You have the right to:\"}],[\"$\",\"ul\",null,{\"className\":\"pl-2 list-inside list-disc\",\"children\":[[\"$\",\"li\",\"Access your personal data\",{\"children\":\"Access your personal data\"}],[\"$\",\"li\",\"Request correction of your personal data\",{\"children\":\"Request correction of your personal data\"}],[\"$\",\"li\",\"Request erasure of your personal data\",{\"children\":\"Request erasure of your personal data\"}],[\"$\",\"li\",\"Object to processing of your personal data\",{\"children\":\"Object to processing of your personal data\"}],[\"$\",\"li\",\"Request restriction of processing your personal data\",{\"children\":\"Request restriction of processing your personal data\"}],[\"$\",\"li\",\"Request transfer of your personal data\",{\"children\":\"Request transfer of your personal data\"}],[\"$\",\"li\",\"Withdraw consent at any time\",{\"children\":\"Withdraw consent at any time\"}]]}],[\"$\",\"h3\",null,{\"children\":\"8. Data Security\"}],[\"$\",\"p\",null,{\"children\":\"We implement appropriate technical and organizational measures to ensure a level of security appropriate to the risk of processing your personal data.\"}],[\"$\",\"h3\",null,{\"children\":\"9. Complaints\"}],[\"$\",\"p\",null,{\"children\":\"If you believe that we have not complied with data protection laws, you have the right to lodge a complaint with the relevant supervisory authority.\"}],[\"$\",\"h3\",null,{\"children\":\"10. Updates to This Privacy Policy\"}],[\"$\",\"p\",null,{\"children\":\"We may update this privacy policy from time to time. We will notify you of any changes by posting the new privacy policy on this page.\"}],[\"$\",\"h3\",null,{\"children\":\"11. Contact Us\"}],[\"$\",\"p\",null,{\"children\":[\"If you have any questions about this privacy policy, please contact us at\",\" \",[\"$\",\"a\",null,{\"href\":\"mailto:gdpr@daniel-freire.com\",\"children\":\"gdpr@daniel-freire.com\"}],\".\"]}]]}]\n10:I[944,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"SpeedInsights\"]\n11:I[3942,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"default\"]\n4:[\"$\",\"html\",null,{\"lang\":\"en\",\"children\":[[\"$\",\"$L10\",null,{}],[\"$\",\"$d\",null,{\"fallback\":null,\"children\":[\"$\",\"$L11\",null,{\"GA_MEASUREMENT_ID\":\"G-0LCR929FXK\"}]}],[\"$\",\"body\",null,{\"className\":\"__variable_440f51 __variable_fb4fc1 __variable_454bfa __variable_5db66a __variable_f35245 antialiased flex min-h-screen selection:bg-(--primary) selection:text-(--selector-txt) \",\"children\":\"$L12\"}]]}]\n13:I[8353,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"738\",\"static/chunks/app/%5Blocale%5D/(legal)/privacy-policy/page-8598d9d8e6090e8c.js\"],\"default\"]\n12:[\"$\",\"$L13\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"about\":{\"image\":\"/images/Lensa/Lensa2.webp\",\"paragraph1\":\"For the last two years, I’ve been building things on the web. But my perspective on what to build, and why, was shaped long before I wrote my first line of code.\",\"paragraph2\":\"I came into this field from marketing, though not the side you might imagine. My world was less about campaigns and more about patterns: analyzing market data, deciphering user behavior, and understanding the precise mechanics of how people find and use a product online. SEO and SEM, at their core, are just applied psychology and problem-solving. You learn to listen to what the data is screaming, and more importantly, to what it’s whispering.\",\"paragraph3\":\"That’s the background I bring to every development project. Most developers can write elegant code; my focus is on building elegant solutions. There’s a crucial difference.\",\"paragraph4\":\"When I architect an application with React or Next.js, I’m not just thinking about state management or component structure. I’m thinking about the user’s journey that brought them there. I’m considering the semantic markup that gives our content meaning beyond the screen. I’m building with an innate understanding of performance because I know firsthand that a delay of even a half-second is a decision a user makes to leave.\",\"paragraph5\":\"Here’s what a lot of talented developers get wrong: they build for the device. They build for the spec. But they forget to build for the human on the other side, and for the business objective that makes the project worthwhile. My experience allows me to sit at that intersection. I can translate a business need into a technical requirement not as an abstract concept, but as a lived experience. I’ve been the person asking for the data, and now I’m the person building the systems that provide it.\",\"paragraph6\":\"Whether it’s a sleek front-end, a robust Django admin, or a full-stack Node.js application, the question I always start with is: \\\"What are we actually solving for?\\\" The technology is a means to an end. The real craft is in choosing the right tool for the job and wielding it with the wisdom of knowing what that job truly is.\",\"paragraph7\":\"I don’t just build things right. I build the right things.\",\"title1\":\"Building for the Human Behind the Screen\"},\"carousel\":[{\"alt\":\"Revolutionize Your Digital Presence Now!\",\"cta\":\"Revolutionize Your Digital Presence!\",\"description\":\"Is your website holding your business back? Our comprehensive performance audit digs deep into your site's technical infrastructure, user experience, and conversion potential. We'll provide a detailed report highlighting critical improvements that can dramatically boost your online performance.\",\"id\":1,\"imageUrl\":\"/images/Carousel/white.webp\",\"loading\":\"lazy\",\"title\":\"revolutionize your digital presence now!\",\"url\":\"/contact\"},{\"alt\":\"Unlock Your Website's Full Potential\",\"cta\":\"Unlock Your Website's Full Potential\",\"description\":\"Websites require consistent care to remain secure, functional, and competitive. Our comprehensive maintenance packages provide proactive monitoring, immediate issue resolution, and continuous technological updates.\",\"id\":2,\"imageUrl\":\"/images/Carousel/umbrellas.webp\",\"loading\":\"eager\",\"title\":\"unlock your website's full potential\",\"url\":\"/contact\"},{\"alt\":\"Build Your Dream Project Today\",\"cta\":\"Build Your Dream Project Today\",\"description\":\"Stop settling for generic templates. Our bespoke web development services create fully customized digital experiences that perfectly align with your brand's unique identity and business objectives. We transform your concept into a powerful, responsive, and cutting-edge web solution.\",\"id\":3,\"imageUrl\":\"/images/Carousel/estatuas.webp\",\"loading\":\"eager\",\"title\":\"build your dream project today\",\"url\":\"/contact\"},{\"alt\":\"Take the First Step Towards Digital Excellence\",\"cta\":\"Take the First Step\",\"description\":\"Speed isn't just a feature—it's a competitive advantage. Our performance optimization service ensures your website loads lightning-fast, providing an exceptional user experience that keeps visitors engaged and converts more effectively.\",\"id\":4,\"imageUrl\":\"/images/Carousel/building-orange.webp\",\"loading\":\"eager\",\"title\":\"accelerate your website's potential\",\"url\":\"/contact\"},{\"alt\":\"Modernize Your Digital Infrastructure\",\"cta\":\"Modernize Your Digital Infrastructure\",\"description\":\"Technology evolves rapidly. Our expert migration services help you seamlessly transition to modern, efficient web technologies without disrupting your existing operations. We ensure a smooth, risk-managed upgrade path.\",\"id\":5,\"imageUrl\":\"/images/Carousel/building-yellow.webp\",\"loading\":\"eager\",\"title\":\"modernize your digital infrastructure\",\"url\":\"/contact\"},{\"alt\":\"pencils\",\"cta\":\"care for your digital assets\",\"description\":\"Websites require consistent care to remain secure, functional, and competitive. Our comprehensive maintenance packages provide proactive monitoring, immediate issue resolution, and continuous technological updates.\",\"id\":6,\"imageUrl\":\"/images/Carousel/pencils.webp\",\"loading\":\"lazy\",\"title\":\"continuous care for your digital assets\",\"url\":\"/contact\"}],\"contact\":{\"btn\":\"send message\",\"email\":\"email\",\"farewell\":{\"text\":\"I appreciate your vote of confidence. You should expect a reply over the next business days.\",\"title\":\"thank you\"},\"firstName\":\"first name\",\"label\":\"I have read and agree with \",\"lastName\":\"last name\",\"message\":\"message\",\"pageTitle\":\"Contact\",\"phone\":\"phone number\",\"placeholder\":{\"email\":\"Input your email\",\"firstName\":\"Input your first name\",\"lastName\":\"Input your last name\",\"message\":\"Input your message\",\"phone\":\"Input your phone number\"},\"privacy\":\"privacy policy\",\"privacyPolicyCheck\":\"I confirm that I read and agree with the\",\"privacyPolicyUrl\":\"privacy-policy/\",\"privacyPolicyUrlAriaDetails\":\"Privacy Policy\",\"privacyPolicyUrlAriaLabel\":\"Privacy Policy\",\"privacyPolicyUrlTitle\":\"Privacy Policy\",\"required\":\"required\",\"title\":\"get in touch\"},\"cookies\":{\"buttonText\":\"Accept All\",\"declineButtonText\":\"Decline All\",\"manageAdvertSubtitle\":\"Personalize advertisements and measure their performance\",\"manageAdvertTitle\":\"Advertising\",\"manageAnalyticsSubtitle\":\"Help us understand how visitors interact with our website\",\"manageAnalyticsTitle\":\"Analytics\",\"manageButtonText\":\"Manage Cookies\",\"manageCancelButtonText\":\"Cancel\",\"manageCookiesStatus\":\"Status: {{status}} on {{date}}\",\"manageCookiesStatusConsented\":\"Consented\",\"manageCookiesStatusDeclined\":\"Declined\",\"manageEssentialStatus\":\"Status: Always enabled\",\"manageEssentialStatusButtonText\":\"Analytics\",\"manageEssentialSubtitle\":\"Required for the website to function properly\",\"manageEssentialTitle\":\"Essential\",\"manageMessage\":\"Manage your cookie preferences below. Essential cookies are always enabled as they are necessary for the website to function properly.\",\"manageSaveButtonText\":\"Save Preferences\",\"manageSocialSubtitle\":\"Enable social media features and sharing\",\"manageSocialTitle\":\"Social\",\"manageTitle\":\"Cookie Preferences\",\"message\":\"We value your privacy. Choose which cookies you want to allow. Essential cookies are always enabled as they are necessary for the website to function properly.\",\"privacyPolicyText\":\"Privacy Policy\",\"privacyurl\":\"/en/privacy-policy\",\"title\":\"Would You Like A Cookie? 🍪\"},\"cta\":{\"blurb\":\"Got a Project in Mind? Let’s Chat.\",\"button\":[\"Let's talk about your business\",\"Got a Project in Mind? Let’s Chat.\",\"Looking for a Web Developer? You Found One!\",\"Say Hello — I Don’t Byte 👋\",\"Let’s Make Your Website Unforgetable →\",\"Need a Developer Who Delivers? Let's Talk.\",\"Let’s Build Something Great Together →\"],\"title\":\"get in touch\"},\"email\":{\"email\":\"hello@daniel-freire.com\",\"message\":\"random message\",\"title\":\"💻🚀 Hello\",\"welcome\":{\"conclusion\":\"This is more than a website—it’s your digital handshake, your first impression, and your opportunity to stand out in a crowded field. Let’s make it unforgettable.\",\"happensNext0\":\"Here’s what happens next:\",\"happensNext1\":\"I’ll personally review your submission and respond with a customized plan (or any questions to refine the scope) within 2–3 business days.\",\"happensNext2\":\"Over the next business days, you’ll hear from me with clear next steps, timelines, and how we’ll collaborate to bring your vision to life.\",\"happensNext3\":\"If you don’t see my email by then, don’t hesitate to follow up—I’m either deep in code or battling my inbox (and I’ll always prioritize your project).\",\"heading\":\"Hello\",\"intro\":\"Let’s start with a simple truth: building an online presence that truly represents your services/skills as a professional takes courage and vision. The fact that you’re here—taking concrete steps to elevate your work—speaks volumes about your commitment to growth. That’s worth celebrating.\",\"introduction\":\"I am Daniel Freire, and I specialize in crafting high-impact, client-focused websites that don’t just display projects but tell a compelling story about what you bring to the table. Whether you’re aiming to attract top-tier clients, land your dream job, or simply showcase your expertise with clarity and style, your website is your most powerful tool. And I’m here to help you sharpen it.\",\"name\":\"Daniel Freire\",\"preview\":\"Daniel Freire's Welcome Email\",\"privacyPolicy\":\"privacy policy\",\"privacyPolicyUrl\":\"en/privacy-policy/\",\"signature\":\"Looking forward to working with you,\",\"view\":\"View the\",\"webLink\":\"daniel-freire.com\",\"whileWait0\":\"While you wait, feel free to:\",\"whileWait1\":\"✅ Reply to this email with any additional thoughts—like specific projects you’re proud of, design preferences, or goals for your website (e.g., “I want recruiters to immediately see my full-stack expertise”). \",\"whileWait2\":\"✅ Gather assets (GitHub links, case studies, or even rough sketches) to streamline the process once we begin.\"}},\"error\":{\"404\":\"404 - page not found\",\"back\":\"Go back to homepage\",\"description\":\"Looks like you got lost. Don't worry, it happens to the best of us.\",\"errorLoading\":{\"contact\":\"<p>If you believe there should a page here, please contact <a>webmaster@daniel-freire.com</a></p>\",\"description\":\"<p>We've unfortunately encountered an error.</p><p>You can try to <retry>reload the page</retry> you were visiting.</p>\",\"title\":\"something went wrong!\"}},\"home\":{\"techstack\":\"Skills & Tools\",\"trending\":\"Portfolio\"},\"icons\":{\"leftarrow\":{\"alt\":\"left arrow\",\"src\":\"/images/icons/chevron-left.svg\"},\"rightarrow\":{\"alt\":\"right arrow\",\"src\":\"/images/icons/chevron-right.svg\"}},\"localeSwitcher\":{\"locale\":\"{locale, select, pt {🇵🇹 Português} en {🇺🇸 English} dk {🇩🇰 Dansk} pl {🇵🇱 Polski} de {🇩🇪 Deutsch} cz {🇨🇿 Český} other {Unknown}}\",\"localeMobile\":\"{locale, select, pt {🇵🇹} en {🇺🇸} dk {🇩🇰} pl {🇵🇱} de {🇩🇪} cz {🇨🇿} other {Unknown}}\"},\"metadata\":{\"description\":{\"about\":\"Learn more about Daniel\",\"contact\":\"This is the best place to contact Daniel\",\"home\":\"Daniel's Introduction\",\"impressum\":\"\",\"portfolio\":\"This is where Daniel will publish his favourite work\",\"privacyPolicy\":\"Find out more about your rights.\"},\"name\":\"Daniel Freire\",\"opengraphImage\":\"metadata/open-graph.png\",\"opengraphImageAlt\":\"Daniel Freire\",\"title\":{\"about\":\"About\",\"contact\":\"Contact\",\"home\":\"Homepage | Daniel Freire\",\"impressum\":\"Impressum\",\"portfolio\":\"Portfolio\",\"privacyPolicy\":\"Privacy Policy\"},\"twitterImage\":\"metadata/open-graph.png\",\"twitterImageAlt\":\"Daniel Freire\"},\"portfolio\":{\"all\":\"All\",\"cta\":[\"check it out\",\"view the live project →\"],\"pageTitle\":\"portfolio\",\"projects\":[{\"demo\":\"Demo\",\"github\":\"https://github.com/danielfreire-dev/Quizzical\",\"link\":\"https://quizzicall-bydainelli.netlify.app/\",\"src\":\"/images/screenshots/quizzical.webp\",\"summary\":\"Trivia game with 4.000+ questions.\",\"title\":\"quizzical\"},{\"demo\":\"Demo\",\"github\":\"https://github.com/danielfreire-dev/PollyGlot\",\"link\":\"https://pollyglot-bydainelli.netlify.app/\",\"src\":\"/images/screenshots/pollyglot.webp\",\"summary\":\"Translation app with AI.\",\"title\":\"pollyGlot\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://danielfreire.pages.dev/Miscellanea/DrumKit/\",\"src\":\"/images/screenshots/drumsVeryBig1920.webp\",\"summary\":\"Fun project to reproduce a Drum Kit in your PC.\",\"title\":\"drum kit app\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://tenzi-bydaniel.netlify.app/\",\"src\":\"/images/screenshots/Tenzi.webp\",\"summary\":\"The world's most popular dice game, now in your browser.\",\"title\":\"tenzi\"}],\"projects-title\":\"Projects\",\"websites\":[{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://muraryu.com\",\"src\":\"/images/screenshots/muraryu.webp\",\"summary\":\"MuraRyu is a new Condominium Management company in Portugal.\",\"title\":\"muraRyu\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://victo.pages.dev\",\"src\":\"/images/screenshots/victo.webp\",\"summary\":\"Gallery website built to showcase the works of the famous Portuguese artist Victó.\",\"title\":\"victó's art gallery\"},{\"demo\":\"Demo\",\"github\":\"\",\"link\":\"https://insurbia.com\",\"src\":\"/images/screenshots/insurbia2.webp\",\"summary\":\"Website developed to be be contact point for the arquitecture collective Insurbia.\",\"title\":\"insurbia\"}],\"websites-title\":\"Websites\"},\"privacyPolicy\":{\"contactEmail\":\"gdpr@daniel-freire.com\",\"header1\":\"1. Introduction\",\"header10\":\"10. Updates to This Privacy Policy\",\"header11\":\"11. Contact Us\",\"header2\":\"2. Information We Collect\",\"header3\":\"3. Purpose of Data Collection\",\"header4\":\"4. Legal Basis for Processing\",\"header5\":\"5. Sharing of Personal Data\",\"header6\":\"6. Data Retention\",\"header7\":\"7. Your Rights\",\"header8\":\"8. Data Security\",\"header9\":\"9. Complaints\",\"paragraph1\":\"Welcome to Daniel Freire's website. We are committed to protecting your personal information and your right to privacy. If you have any questions or concerns about this privacy notice or our practices with regard to your personal information, please contact us at\",\"paragraph10\":\"We may update this privacy policy from time to time. We will notify you of any changes by posting the new privacy policy on this page.\",\"paragraph11\":\"If you have any questions about this privacy policy, please contact us at\",\"paragraph2\":\"We collect personal information that you voluntarily provide to us when you fill out a form on our website. The personal information we collect includes:\",\"paragraph2li\":[\"First name\",\"Last name\",\"Email address\",\"Phone number\"],\"paragraph3\":\"The information we collect will be used to contact you in the future. We will only use your personal data for this specific purpose.\",\"paragraph4\":\"We process your personal data based on your consent, which you provide by filling out the form on our website.\",\"paragraph5\":\"We do not share your personal data with third parties except as required by law.\",\"paragraph6\":\"We will retain your personal data only for as long as necessary to fulfill the purposes we collected it for, including for the purposes of satisfying any legal requirements.\",\"paragraph7\":\"You have the right to:\",\"paragraph7li\":[\"Access your personal data\",\"Request correction of your personal data\",\"Request erasure of your personal data\",\"Object to processing of your personal data\",\"Request restriction of processing your personal data\",\"Request transfer of your personal data\",\"Withdraw consent at any time\"],\"paragraph8\":\"We implement appropriate technical and organizational measures to ensure a level of security appropriate to the risk of processing your personal data.\",\"paragraph9\":\"If you believe that we have not complied with data protection laws, you have the right to lodge a complaint with the relevant supervisory authority.\",\"title\":\"Privacy Policy for Daniel Freire's Website\"},\"services\":[{\"icon\":\"/images/icons/business-processes.svg\",\"text\":\"Tailored web applications — CRMs, dashboards, and internal tools that fit how your business actually works.\",\"title\":\"Business Custom Software\"},{\"icon\":\"/images/icons/ai-recommend.svg\",\"text\":\"Integrating AI into your workflows — chatbots, intelligent automation, and data-driven features.\",\"title\":\"AI Solution Implementation\"},{\"icon\":\"/images/icons/dns-services.svg\",\"text\":\"Modern, performant websites and applications built with React, Next.js, and TypeScript.\",\"title\":\"Web Development\"},{\"icon\":\"/images/icons/ibm-watson--machine-learning.svg\",\"text\":\"Data-backed audits, performance optimization, and strategy to help your business get found.\",\"title\":\"SEO & Technical Consulting\"}],\"sidenav\":{\"footer\":{\"blurb\":\"Made with 🐞 by\",\"icons\":{\"github\":{\"alt\":\"GitHub\",\"ariaDetails\":\"Daniel Freire's GitHub\",\"ariaLAbel\":\"Daniel Freire's GitHub\",\"link\":\"https://github.com/danielfreire-dev/\",\"src\":\"/images/icons/github-square.svg\",\"title\":\"Daniel Freire's GitHub\"},\"linkedin\":{\"alt\":\"LinkedIn\",\"ariaDetails\":\"Daniel Freire's Linkedin\",\"ariaLAbel\":\"Daniel Freire's Linkedin\",\"link\":\"https://www.linkedin.com/in/danielfreire-swe/\",\"src\":\"/images/icons/linkedin.svg\",\"title\":\"Daniel Freire's Linkedin\"}}},\"header\":{\"role\":\"web developer\",\"title\":\"daniel freire\"},\"legal\":{\"impressumLink\":\"/impressum\",\"impressumName\":\"impressum\",\"privacyLink\":\"/privacy-policy\",\"privacyLinkAriaDetails\":\"Privacy Policy\",\"privacyLinkAriaLabel\":\"Privacy Policy\",\"privacyLinkTitle\":\"Privacy Policy\",\"privacyName\":\"privacy policy\"},\"links\":[{\"link\":\"/\",\"name\":\"home\"},{\"link\":\"/about\",\"name\":\"about\"},{\"link\":\"/portfolio\",\"name\":\"portfolio\"},{\"link\":\"/contact\",\"name\":\"contact\"}],\"privacy\":\"privacy policy\",\"rights\":\"Daniel Freire ® all rights reserved\",\"select\":{\"languageSelectAriaLabel\":\"Select Language Menu\",\"languageSelectTitle\":\"Select Language Menu\"}},\"tech\":[{\"link\":\"https://nextjs.org\",\"logo\":\"/images/icons/nextjs-13.svg\",\"name\":\"next.js\",\"svgr\":\"Nextjs\"},{\"link\":\"https://react.dev\",\"logo\":\"/images/icons/react2.svg\",\"name\":\"react.js\",\"svgr\":\"Reactjs\"},{\"link\":\"https://nodejs.org/en\",\"logo\":\"/images/icons/node-js.svg\",\"name\":\"node.js\",\"svgr\":\"Nodejs\"},{\"link\":\"https://www.typescriptlang.org\",\"logo\":\"/images/icons/Typescript.svg\",\"name\":\"typeScript\",\"svgr\":\"TypeScript\"},{\"link\":\"https://developer.mozilla.org/en-US/docs/Web/JavaScript\",\"logo\":\"/images/icons/javascript-original.svg\",\"name\":\"javaScript\",\"svgr\":\"JavaScript\"},{\"link\":\"https://www.w3.org/html/\",\"logo\":\"/images/icons/html5-original-wordmark.svg\",\"name\":\"HTML5\",\"svgr\":\"HTML5\"},{\"link\":\"https://developer.mozilla.org/en-US/docs/Web/CSS\",\"logo\":\"/images/icons/Official_CSS_Logo.svg\",\"name\":\"CSS3\",\"svgr\":\"CSS3\"},{\"link\":\"https://www.postgresql.org\",\"logo\":\"/images/icons/postgresql.svg\",\"name\":\"postgreSQL\",\"svgr\":\"PostgreSQL\"},{\"link\":\"https://vite.dev\",\"logo\":\"/images/icons/vitejs.svg\",\"name\":\"vite.js\",\"svgr\":\"Vitejs\"},{\"link\":\"https://webpack.js.org/\",\"logo\":\"/images/icons/webpack.svg\",\"name\":\"webpack\",\"svgr\":\"Webpack\"},{\"link\":\"https://github.com/\",\"logo\":\"/images/icons/github.svg\",\"name\":\"gitHub\",\"svgr\":\"Github\"},{\"link\":\"https://git-scm.com/\",\"logo\":\"/images/icons/git-scm-icon.svg\",\"name\":\"git\",\"svgr\":\"Git\"},{\"link\":\"https://vitest.dev/\",\"logo\":\"/images/icons/vitest.svg\",\"name\":\"vitest\",\"svgr\":\"Vitest\"},{\"link\":\"https://jestjs.io/\",\"logo\":\"/images/icons/jestjsio-icon.svg\",\"name\":\"jest\",\"svgr\":\"Jest\"},{\"link\":\"https://selenium-python.readthedocs.io/\",\"logo\":\"/images/icons/selenium.svg\",\"name\":\"selenium\",\"svgr\":\"Selenium\"},{\"link\":\"https://www.python.org/\",\"logo\":\"/images/icons/python-original.svg\",\"name\":\"python\",\"svgr\":\"Python\"},{\"link\":\"https://www.linux.org/\",\"logo\":\"/images/icons/linux-original.svg\",\"name\":\"linux\",\"svgr\":\"Linux\"}],\"topMainPage\":{\"blurbsArray\":[{\"description\":\"Is your website holding back your business growth? Our comprehensive performance audit deeply analyzes your technical infrastructure, user experience, and conversion potential. We’ll provide a detailed report highlighting critical improvements that can dramatically boost your online performance.\",\"title\":\"Revolutionize Your Digital Presence Now!\"},{\"description\":\"Websites require constant care to stay secure, functional, and competitive. Our comprehensive maintenance packages offer proactive monitoring, immediate issue resolution, and continuous technological updates.\",\"title\":\"Unlock Your Website’s Full Potential\"},{\"description\":\"Stop settling for generic templates. Our custom web development services create fully tailored digital experiences that align perfectly with your brand’s unique identity and business goals. We transform your concept into a powerful, responsive, and cutting-edge web solution.\",\"title\":\"Build Your Dream Project Today\"},{\"description\":\"Speed isn’t just a feature—it’s a competitive advantage. Our performance optimization service ensures your website loads extremely fast, delivering an exceptional user experience that keeps visitors engaged and converts more effectively.\",\"title\":\"Accelerate Your Website’s Potential\"},{\"description\":\"Technology evolves rapidly. Our specialized migration services help you transition seamlessly to modern, efficient web technologies without disrupting your existing operations. We ensure a smooth, risk-managed upgrade path.\",\"title\":\"Modernize Your Digital Infrastructure\"},{\"description\":\"Websites require constant care to remain secure, functional, and competitive. Our comprehensive maintenance packages offer proactive monitoring, immediate issue resolution, and continuous technological updates.\",\"title\":\"Ongoing Care for Your Digital Assets\"}],\"p1\":\"Tired of software that holds your business back?\",\"p2\":\"Most business software is either too rigid or too complex. I specialize in developing custom web applications—like CRM systems, project trackers, and data dashboards—that fit how your business actually works. If you need a tool that solves a specific problem without unnecessary features, let’s discuss what you’re trying to achieve.\"}},\"now\":\"$undefined\",\"timeZone\":\"Europe/Lisbon\",\"children\":\"$L14\"}]\n15:I[59,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"Providers\"]\n16:I[5564,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"908\",\"static/chunks/908-6bb2778964e2ca03.js\",\"51\",\"static/chunks/51-063b24f715f61199.js\",\"261\",\"static/chunks/261-e6773460e5f3e14a.js\",\"450\",\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\"],\"default\"]\n17:I[4275,[\"694\",\"static/chunks/694-009548b009ecd054.js\",\"530\",\"static/chunks/app/%5Blocale%5D/error-8ecce493219f8816.js\"],\"default\"]\n14:[\"$\",\"$L15\",null,{\"children\":[[\"$\",\"header\",null,{\"className\":\"flex flex-row\",\"children\":[\"$\",\"$L16\",null,{}]}],[\"$\",\"main\",null,{\"className\":\"flex flex-1 justify-center flex-col overflow-hidden pb-5 mt-9\",\"children\":[\"$\",\"div\",null,{\"id\":\"main\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$17\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]]}]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n7:null\n18:I[3407,[],\"IconMark\"]\n9:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Privacy Policy | Daniel Freire\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Find out more about your rights.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://daniel-freire.com/\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Daniel Freire\"}],[\"$\",\"link\",\"4\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"5\",{\"name\":\"keywords\",\"content\":\"Daniel Freire,Portfolio,Next.js,React,TypeScript,JavaScript,Digital Marketing\"}],[\"$\",\"meta\",\"6\",{\"name\":\"creator\",\"content\":\"Daniel Freire\"}],[\"$\",\"link\",\"7\",{\"rel\":\"canonical\",\"href\":\"https://daniel-freire.com\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://daniel-freire.com/en\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"hrefL