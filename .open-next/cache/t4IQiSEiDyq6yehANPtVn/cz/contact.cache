rossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L6\\\",null,{\\\"children\\\":[\\\"$L7\\\",[\\\"$\\\",\\\"$L8\\\",null,{\\\"promise\\\":\\\"$@9\\\"}]]}]]}],{},null,false]},null,false]},null,false]},null,false],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[[\\\"$\\\",\\\"$La\\\",null,{\\\"children\\\":\\\"$Lb\\\"}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$Lc\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$d\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$Le\\\"}]}]}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$f\\\",[]],\\\"s\\\":false,\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"10:I[7134,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"638\\\",\\\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\\\"],\\\"default\\\"]\\n5:[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mx-auto text-center capitalize mb-4\\\",\\\"children\\\":\\\"Kontakt\\\"}],[\\\"$\\\",\\\"$L10\\\",null,{}]]\\n\"])</script><script>self.__next_f.push([1,\"11:I[944,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"SpeedInsights\\\"]\\n12:I[3942,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"default\\\"]\\n4:[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"cz\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",null,{}],[\\\"$\\\",\\\"$d\\\",null,{\\\"fallback\\\":null,\\\"children\\\":[\\\"$\\\",\\\"$L12\\\",null,{\\\"GA_MEASUREMENT_ID\\\":\\\"G-0LCR929FXK\\\"}]}],[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"__variable_440f51 __variable_fb4fc1 __variable_454bfa __variable_5db66a __variable_f35245 antialiased flex min-h-screen selection:bg-(--primary) selection:text-(--selector-txt) \\\",\\\"children\\\":\\\"$L13\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"14:I[8353,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"638\\\",\\\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"$L14\\\",null,{\\\"formats\\\":\\\"$undefined\\\",\\\"locale\\\":\\\"cz\\\",\\\"messages\\\":{\\\"about\\\":{\\\"image\\\":\\\"/images/Lensa/Lensa2.webp\\\",\\\"paragraph1\\\":\\\"Během posledních dvou let jsem na webu budoval různé věci. Ale můj pohled na to, co a proč budovat, byl formován mnohem dříve, než jsem napsal svůj první řádek kódu.\\\",\\\"paragraph2\\\":\\\"Do tohoto oboru jsem přišel z marketingu, i když ne z té strany, kterou si mnozí představují. Můj svět byl spíše o analýze dat než o kampaních – sledování tržních trendů, rozbor chování uživatelů a porozumění přesnému mechanismu, jak lidé online nachází a používají produkty. SEO a SEM jsou ve svém jádru aplikovaná psychologie a řešení problémů. Naučil jsem se poslouchat, co data křičí, a co ještě důležitější – co šeptají.\\\",\\\"paragraph3\\\":\\\"To je přínos, který přináším do každého vývojářského projektu. Mnoho vývojářů umí psát elegantní kód; já se zaměřuji na vytváření elegantních řešení. A v tom je ten rozdíl.\\\",\\\"paragraph4\\\":\\\"Když navrhuji aplikaci v Reactu nebo Next.js, nemyslím jen na správu stavu nebo strukturu komponent. Myslím na cestu uživatele, která ho sem přivedla. Uvažuji o sémantickém značkování, které dává našemu obsahu význam i mimo obrazovku. Buduji s přirozeným porozuměním výkonu, protože vím, že zpoždění i o půl vteřiny může znamenat rozhodnutí uživatele odejít.\\\",\\\"paragraph5\\\":\\\"Zde dělá chybu mnoho talentovaných vývojářů: budují pro zařízení. Budují pro specifikaci. Ale zapomínají budovat pro člověka na druhé straně a pro obchodní cíl, který projekt opravdu odůvodňuje. Díky mé zkušenosti se dokážu postavit právě na toto průsečík. Umím převést obchodní potřebu na technický požadavek ne jako abstraktní koncept, ale jako žijící zkušenost. Byl jsem člověk, který žádal o data, a teď jsem ten, kdo systémy pro jejich poskytování vytváří.\\\",\\\"paragraph6\\\":\\\"Ať už jde o moderní frontend, robustní Django admin nebo full-stack Node.js aplikaci, otázkou, od které vždy začínám, je: „Na co vlastně hledáme řešení?“ Technologie jsou prostředkem. Skutečné umění tkví ve výběru správného nástroje pro danou práci a v jeho schopnosti jej použít s moudrostí, abych pochopil, co je ta práce skutečně zač.\\\",\\\"paragraph7\\\":\\\"Nestavím jen správně. Stavím správné věci.\\\",\\\"title1\\\":\\\"Stavíme pro člověka za obrazovkou\\\"},\\\"carousel\\\":[{\\\"alt\\\":\\\"Revolutionizujte svou digitální prezentaci!\\\",\\\"cta\\\":\\\"Revolutionizujte svou digitální prezentaci!\\\",\\\"description\\\":\\\"Drží vaše webové stránky váš podnik zpět? Náš komplexní audit výkonu hloubkově analyzuje technickou infrastrukturu, uživatelský zážitek a konverzní potenciál vašich stránek. Poskytneme vám detailní zprávu s klíčovými návrhy na zlepšení, které dramaticky zvýší vaši online výkonnost.\\\",\\\"id\\\":1,\\\"imageUrl\\\":\\\"/images/Carousel/white.webp\\\",\\\"loading\\\":\\\"lazy\\\",\\\"title\\\":\\\"revolučně zlepšete svou digitální prezentaci!\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Uvolněte plný potenciál vašich webových stránek\\\",\\\"cta\\\":\\\"Uvolněte plný potenciál vašich webových stránek\\\",\\\"description\\\":\\\"Weby potřebují pravidelnou péči, aby zůstaly bezpečné, funkční a konkurenceschopné. Naše komplexní balíčky údržby zahrnují proaktivní sledování, okamžité řešení problémů a kontinuální technologické aktualizace.\\\",\\\"id\\\":2,\\\"imageUrl\\\":\\\"/images/Carousel/umbrellas.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"uvolněte plný potenciál vašich webových stránek\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Vytvořte svůj sen dnes\\\",\\\"cta\\\":\\\"Vytvořte svůj sen dnes\\\",\\\"description\\\":\\\"Přestaňte se spokojit s generickými šablonami. Naše individuální služby vývoje webu vytvářejí plně přizpůsobené digitální zkušenosti, které dokonale ladí s unikátní identitou vaší značky a obchodními cíli. Proměníme váš koncept ve výkonný, responzivní a moderní web.\\\",\\\"id\\\":3,\\\"imageUrl\\\":\\\"/images/Carousel/estatuas.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"vytvořte svůj sen dnes\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Udělejte první krok směrem k digitální excelenci\\\",\\\"cta\\\":\\\"Udělejte první krok\\\",\\\"description\\\":\\\"Rychlost není jen funkce – je to konkurenční výhoda. Naše optimalizace výkonu zajistí, že váš web bude načítán bleskurychle a poskytne výjimečný uživatelský zážitek, který udrží návštěvníky a zvýší konverze.\\\",\\\"id\\\":4,\\\"imageUrl\\\":\\\"/images/Carousel/building-orange.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"urychlete potenciál vašich stránek\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Modernizujte svou digitální infrastrukturu\\\",\\\"cta\\\":\\\"Modernizujte svou digitální infrastrukturu\\\",\\\"description\\\":\\\"Technologie se rychle vyvíjejí. Naše expertní migrační služby vám pomohou hladce přejít na moderní a efektivní webové technologie bez narušení stávajících operací. Zajistíme hladkou a bezrizikovou cestu k modernizaci.\\\",\\\"id\\\":5,\\\"imageUrl\\\":\\\"/images/Carousel/building-yellow.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"modernizujte svou digitální infrastrukturu\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"tužky\\\",\\\"cta\\\":\\\"pečujte o své digitální aktiva\\\",\\\"description\\\":\\\"Weby potřebují pravidelnou péči, aby zůstaly bezpečné, funkční a konkurenceschopné. Naše komplexní balíčky údržby zahrnují proaktivní sledování, okamžité řešení problémů a kontinuální technologické aktualizace.\\\",\\\"id\\\":6,\\\"imageUrl\\\":\\\"/images/Carousel/pencils.webp\\\",\\\"loading\\\":\\\"lazy\\\",\\\"title\\\":\\\"průběžná péče o vaše digitální aktiva\\\",\\\"url\\\":\\\"/contact\\\"}],\\\"contact\\\":{\\\"btn\\\":\\\"odeslat zprávu\\\",\\\"email\\\":\\\"email\\\",\\\"farewell\\\":{\\\"text\\\":\\\"Děkujeme za vaši důvěru. Můžete očekávat odpověď během několika pracovních dní.\\\",\\\"title\\\":\\\"děkujeme\\\"},\\\"firstName\\\":\\\"jméno\\\",\\\"label\\\":\\\"Přečetl jsem si a souhlasím s \\\",\\\"lastName\\\":\\\"příjmení\\\",\\\"message\\\":\\\"zpráva\\\",\\\"pageTitle\\\":\\\"Kontakt\\\",\\\"phone\\\":\\\"telefonní číslo\\\",\\\"placeholder\\\":{\\\"email\\\":\\\"Zadejte svůj email\\\",\\\"firstName\\\":\\\"Zadejte své jméno\\\",\\\"lastName\\\":\\\"Zadejte své příjmení\\\",\\\"message\\\":\\\"Zadejte zprávu\\\",\\\"phone\\\":\\\"Zadejte své telefonní číslo\\\"},\\\"privacy\\\":\\\"zásady ochrany osobních údajů\\\",\\\"privacyPolicyCheck\\\":\\\"Potvrzuji, že jsem si přečetl(a) a souhlasím s\\\",\\\"privacyPolicyUrl\\\":\\\"privacy-policy/\\\",\\\"privacyPolicyUrlAriaDetails\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyPolicyUrlAriaLabel\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyPolicyUrlTitle\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"required\\\":\\\"povinné\\\",\\\"title\\\":\\\"kontaktujte mě\\\"},\\\"cookies\\\":{\\\"buttonText\\\":\\\"Přijmout vše\\\",\\\"declineButtonText\\\":\\\"Odmítnout vše\\\",\\\"manageAdvertSubtitle\\\":\\\"Přizpůsobit reklamy a měřit jejich výkon\\\",\\\"manageAdvertTitle\\\":\\\"Reklamy\\\",\\\"manageAnalyticsSubtitle\\\":\\\"Pomozte nám pochopit, jak návštěvníci interagují s naším webem\\\",\\\"manageAnalyticsTitle\\\":\\\"Analytika\\\",\\\"manageButtonText\\\":\\\"Spravovat cookies\\\",\\\"manageCancelButtonText\\\":\\\"Zrušit\\\",\\\"manageCookiesStatus\\\":\\\"Stav: {{status}} dne {{date}}\\\",\\\"manageCookiesStatusConsented\\\":\\\"Souhlas\\\",\\\"manageCookiesStatusDeclined\\\":\\\"Odmítnuto\\\",\\\"manageEssentialStatus\\\":\\\"Stav: Vždy povoleno\\\",\\\"manageEssentialStatusButtonText\\\":\\\"Analytika\\\",\\\"manageEssentialSubtitle\\\":\\\"Nutné pro správné fungování webu\\\",\\\"manageEssentialTitle\\\":\\\"Základní\\\",\\\"manageMessage\\\":\\\"Spravujte své nastavení cookies níže. Základní cookies jsou vždy povoleny, protože jsou nezbytné pro fungování webu.\\\",\\\"manageSaveButtonText\\\":\\\"Uložit nastavení\\\",\\\"manageSocialSubtitle\\\":\\\"Povolit funkce sociálních médií a sdílení\\\",\\\"manageSocialTitle\\\":\\\"Sociální sítě\\\",\\\"manageTitle\\\":\\\"Nastavení cookies\\\",\\\"message\\\":\\\"Vážíme si vašeho soukromí. Vyberte si, které cookies chcete povolit. Základní cookies jsou vždy povoleny, protože jsou nezbytné pro fungování webu.\\\",\\\"privacyPolicyText\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyurl\\\":\\\"/en/privacy-policy\\\",\\\"title\\\":\\\"Chcete sušenku? 🍪\\\"},\\\"cta\\\":{\\\"blurb\\\":\\\"Máte projekt v hlavě? Pojďme si promluvit.\\\",\\\"button\\\":[\\\"Pojďme si promluvit o vašem podnikání\\\",\\\"Máte projekt v hlavě? Pojďme si promluvit.\\\",\\\"Hledáte frontend vývojáře? Našli jste ho!\\\",\\\"Pozdravujte – nekoušu 👋\\\",\\\"Udělejme z vašeho webu něco nezapomenutelného →\\\",\\\"Potřebujete vývojáře, který doručí? Promluvme si.\\\",\\\"Pojďme spolu něco skvělého vytvořit →\\\"],\\\"title\\\":\\\"kontaktujte mě\\\"},\\\"email\\\":{\\\"email\\\":\\\"hello@daniel-freire.com\\\",\\\"message\\\":\\\"náhodná zpráva\\\",\\\"title\\\":\\\"💻🚀 Ahoj\\\",\\\"welcome\\\":{\\\"conclusion\\\":\\\"Tohle není jen web – je to váš digitální úsměv, první dojem a příležitost vyniknout ve světě plném konkurence. Udělejme z něj něco nezapomenutelného.\\\",\\\"happensNext0\\\":\\\"Co bude dál:\\\",\\\"happensNext1\\\":\\\"Osobně si projdu váš dotaz a odpovím vám do 2–3 pracovních dní s přizpůsobeným plánem (nebo otázkami, pokud bude potřeba upřesnit rozsah).\\\",\\\"happensNext2\\\":\\\"Během několika pracovních dní se vám ozvu s jasnými dalšími kroky, časovým harmonogramem a tím, jak spolu budeme spolupracovat na přivedení vašeho nápadu k životu.\\\",\\\"happensNext3\\\":\\\"Pokud do té doby neuvidíte můj email, neváhejte mi napsat znovu – buď se ponořím do kódu, nebo budu bojovat s poštou (a vždycky si udělám čas pro váš projekt).\\\",\\\"heading\\\":\\\"Ahoj\\\",\\\"intro\\\":\\\"Začněme jednoduchou pravdou: vytvořit online přítomnost, která skutečně reprezentuje vaše služby nebo dovednosti, vyžaduje odvahu a vizi. Fakt, že jste tady – a podnikáte konkrétní kroky ke zlepšení – říká mnoho o vašem odhodlání růst. To si zaslouží oslavu.\\\",\\\"introduction\\\":\\\"Jsem Daniel Freire a specializuji se na vytváření silných, klientům přizpůsobených webů, které nejen ukazují projekty, ale vypráví příběh o tom, co do toho vkládáte. Ať už si přejete přilákat špičkové klienty, získat svou vysněnou práci nebo jen jasně a stylově prezentovat své schopnosti – váš web je nejsilnější nástroj. A já vám pomohu ho vyleštit.\\\",\\\"name\\\":\\\"Daniel Freire\\\",\\\"preview\\\":\\\"Daniel Freire – uvítací email\\\",\\\"privacyPolicy\\\":\\\"zásady ochrany osobních údajů\\\",\\\"privacyPolicyUrl\\\":\\\"en/privacy-policy/\\\",\\\"signature\\\":\\\"Těším se na spolupráci,\\\",\\\"view\\\":\\\"Zobrazit\\\",\\\"webLink\\\":\\\"daniel-freire.com\\\",\\\"whileWait0\\\":\\\"Zatímco čekáte, můžete:\\\",\\\"whileWait1\\\":\\\"✅ Odpovědět na tento email s dalšími myšlenkami – třeba konkrétní projekty, které vás baví, designové preference nebo cíle pro váš web (např. „Chci, aby recruiteři hned viděli mou full-stack expertízu“).\\\",\\\"whileWait2\\\":\\\"✅ Shromáždit materiály (odkazy na GitHub, case study nebo i hrubé náčrty), abychom urychlili proces, až začneme.\\\"}},\\\"error\\\":{\\\"404\\\":\\\"404 – stránka nenalezena\\\",\\\"back\\\":\\\"Zpět na domovskou stránku\\\",\\\"description\\\":\\\"Vypadá to, že jste se ztratil. Nebojte se, stává se to i těm nejlepším.\\\",\\\"errorLoading\\\":{\\\"contact\\\":\\\"\\u003cp\\u003ePokud si myslíte, že zde nějaká stránka být měla, kontaktujte \\u003ca\\u003ewebmaster@daniel-freire.com\\u003c/a\\u003e\\u003c/p\\u003e\\\",\\\"description\\\":\\\"\\u003cp\\u003eBohužel jsme narazili na chybu.\\u003c/p\\u003e\\u003cp\\u003eMůžete zkusit \\u003cretry\\u003eznovu načíst stránku\\u003c/retry\\u003e, kterou jste navštívili.\\u003c/p\\u003e\\\",\\\"title\\\":\\\"něco se pokazilo!\\\"}},\\\"home\\\":{\\\"techstack\\\":\\\"Dovednosti a nástroje\\\",\\\"trending\\\":\\\"Portfolio\\\"},\\\"icons\\\":{\\\"leftarrow\\\":{\\\"alt\\\":\\\"šipka vlevo\\\",\\\"src\\\":\\\"/images/icons/chevron-left.svg\\\"},\\\"rightarrow\\\":{\\\"alt\\\":\\\"šipka vpravo\\\",\\\"src\\\":\\\"/images/icons/chevron-right.svg\\\"}},\\\"localeSwitcher\\\":{\\\"locale\\\":\\\"{locale, select, pt {🇵🇹 Português} en {🇺🇸 English} dk {🇩🇰 Dansk} pl {🇵🇱 Polski} de {🇩🇪 Deutsch} cz {🇨🇿 Český} other {Unknown}}\\\",\\\"localeMobile\\\":\\\"{locale, select, pt {🇵🇹} en {🇺🇸} dk {🇩🇰} pl {🇵🇱} de {🇩🇪} cz {🇨🇿} other {Unknown}}\\\"},\\\"metadata\\\":{\\\"description\\\":{\\\"about\\\":\\\"Zjistěte více o Danielovi\\\",\\\"contact\\\":\\\"Tohle je nejlepší místo, kde kontaktovat Daniela\\\",\\\"home\\\":\\\"Danielův úvod\\\",\\\"impressum\\\":\\\"\\\",\\\"portfolio\\\":\\\"Zde Daniel zveřejňuje své oblíbené práce\\\",\\\"privacyPolicy\\\":\\\"Zjistěte více o svých právech.\\\"},\\\"name\\\":\\\"Daniel Freire\\\",\\\"opengraphImage\\\":\\\"metadata/open-graph.png\\\",\\\"opengraphImageAlt\\\":\\\"Daniel Freire\\\",\\\"title\\\":{\\\"about\\\":\\\"O mně\\\",\\\"contact\\\":\\\"Kontakt\\\",\\\"home\\\":\\\"Domovská stránka | Daniel Freire\\\",\\\"impressum\\\":\\\"Impressum\\\",\\\"portfolio\\\":\\\"Portfolio\\\",\\\"privacyPolicy\\\":\\\"Zásady ochrany osobních údajů\\\"},\\\"twitterImage\\\":\\\"metadata/open-graph.png\\\",\\\"twitterImageAlt\\\":\\\"Daniel Freire\\\"},\\\"portfolio\\\":{\\\"all\\\":\\\"Vše\\\",\\\"cta\\\":[\\\"podívejte se\\\",\\\"zobrazit živý projekt →\\\"],\\\"pageTitle\\\":\\\"portfolio\\\",\\\"projects\\\":[{\\\"link\\\":\\\"https://quizzicall-bydainelli.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/quizzical.webp\\\",\\\"summary\\\":\\\"Hra na otázky s více než 4 000 otázkami.\\\",\\\"title\\\":\\\"quizzical\\\"},{\\\"link\\\":\\\"https://pollyglot-bydainelli.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/pollyglot.webp\\\",\\\"summary\\\":\\\"Překladová aplikace s AI.\\\",\\\"title\\\":\\\"pollyGlot\\\"},{\\\"link\\\":\\\"https://danielfreire.pages.dev/Miscellanea/DrumKit/\\\",\\\"src\\\":\\\"/images/screenshots/drumsVeryBig1920.webp\\\",\\\"summary\\\":\\\"Zábavný projekt na simulaci bicích nástrojů na počítači.\\\",\\\"title\\\":\\\"aplikace bicích\\\"},{\\\"link\\\":\\\"https://tenzi-bydaniel.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/Tenzi.webp\\\",\\\"summary\\\":\\\"Nejpopulárnější kostková hra na světě, nyní ve vašem prohlížeči.\\\",\\\"title\\\":\\\"tenzi\\\"}],\\\"projects-title\\\":\\\"Projekty\\\",\\\"websites\\\":[{\\\"link\\\":\\\"https://muraryu.com\\\",\\\"src\\\":\\\"/images/screenshots/muraryu.webp\\\",\\\"summary\\\":\\\"MuraRyu je nová společnost v Portugalsku pro správu bytových domů.\\\",\\\"title\\\":\\\"muraRyu\\\"},{\\\"link\\\":\\\"https://victo.pages.dev\\\",\\\"src\\\":\\\"/images/screenshots/victo.webp\\\",\\\"summary\\\":\\\"Galerie vytvořená pro prezentaci děl známého portugalského umělce Victóa.\\\",\\\"title\\\":\\\"galerie Victóa\\\"},{\\\"link\\\":\\\"https://insurbia.com\\\",\\\"src\\\":\\\"/images/screenshots/insurbia2.webp\\\",\\\"summary\\\":\\\"Webové stránky vytvořené jako kontaktní místo pro architektonické kolektiv Insurbia.\\\",\\\"title\\\":\\\"insurbia\\\"}],\\\"websites-title\\\":\\\"Weby\\\"},\\\"privacyPolicy\\\":{\\\"contactEmail\\\":\\\"gdpr@daniel-freire.com\\\",\\\"header1\\\":\\\"1. Úvod\\\",\\\"header10\\\":\\\"10. Změny v těchto zásadách ochrany osobních údajů\\\",\\\"header11\\\":\\\"11. Kontaktujte nás\\\",\\\"header2\\\":\\\"2. Jaké informace sbíráme\\\",\\\"header3\\\":\\\"3. Účel sběru dat\\\",\\\"header4\\\":\\\"4. Právní základ zpracování\\\",\\\"header5\\\":\\\"5. Sdílení osobních údajů\\\",\\\"header6\\\":\\\"6. Uchovávání dat\\\",\\\"header7\\\":\\\"7. Vaše práva\\\",\\\"header8\\\":\\\"8. Bezpečnost dat\\\",\\\"header9\\\":\\\"9. Stížnosti\\\",\\\"paragraph1\\\":\\\"Vítejte na webových stránkách Daniela Freire. Jsme odhodláni chránit vaše osobní údaje a vaše právo na soukromí. Pokud máte jakékoli otázky nebo obavy ohledně těchto zásad ochrany osobních údajů nebo našich postupů při zpracování vašich osobních údajů, kontaktujte nás na\\\",\\\"paragraph10\\\":\\\"Tyto zásady ochrany osobních údajů můžeme čas od času aktualizovat. O jakýchkoli změnách vás budeme informovat zveřejněním nových zásad na této stránce.\\\",\\\"paragraph11\\\":\\\"Pokud máte jakékoli otázky týkající se těchto zásad ochrany osobních údajů, kontaktujte nás na\\\",\\\"paragraph2\\\":\\\"Sbíráme osobní údaje, které nám dobrovolně poskytnete při vyplňování formuláře na našich webových stránkách. Osobní údaje, které sbíráme, zahrnují:\\\",\\\"paragraph2li\\\":[\\\"Jméno\\\",\\\"Příjmení\\\",\\\"Emailová adresa\\\",\\\"Telefonní číslo\\\"],\\\"paragraph3\\\":\\\"Informace, které sbíráme, budou použity k tomu, abychom vás v budoucnu kontaktovali. Vaše osobní údaje budeme používat pouze pro tento konkrétní účel.\\\",\\\"paragraph4\\\":\\\"Zpracování vašich osobních údajů je založeno na vašem souhlasu, který udělujete vyplněním formuláře na našich webových stránkách.\\\",\\\"paragraph5\\\":\\\"Vaše osobní údaje nesdílíme s třetími stranami, kromě případů požadovaných zákonem.\\\",\\\"paragraph6\\\":\\\"Vaše osobní údaje budeme uchovávat pouze po dobu nezbytnou k naplnění účelu, pro který byly shromážděny, včetně splnění právních požadavků.\\\",\\\"paragraph7\\\":\\\"Máte právo:\\\",\\\"paragraph7li\\\":[\\\"Přístup k vašim osobním údajům\\\",\\\"Požadavek na opravu vašich osobních údajů\\\",\\\"Požadavek na výmaz vašich osobních údajů\\\",\\\"Námitka proti zpracování vašich osobních údajů\\\",\\\"Požadavek na omezení zpracování vašich osobních údajů\\\",\\\"Požadavek na přenos vašich osobních údajů\\\",\\\"Kdykoli odvolat souhlas\\\"],\\\"paragraph8\\\":\\\"Implementujeme přiměřená technická a organizační opatření k zajištění úrovně zabezpečení odpovídající riziku zpracování vašich osobních údajů.\\\",\\\"paragraph9\\\":\\\"Pokud se domníváte, že jsme nepostupovali v souladu se zákony o ochraně osobních údajů, máte právo podat stížnost u příslušného dozorového orgánu.\\\",\\\"title\\\":\\\"Zásady ochrany osobních údajů pro webové stránky Daniela Freire\\\"},\\\"services\\\":[{\\\"icon\\\":\\\"/images/icons/business-processes.svg\\\",\\\"text\\\":\\\"Webové aplikace na míru — CRM systémy, dashboardy a interní nástroje, které odpovídají tomu, jak vaše firma skutečně funguje.\\\",\\\"title\\\":\\\"Zakázkový firemní software\\\"},{\\\"icon\\\":\\\"/images/icons/ai-recommend.svg\\\",\\\"text\\\":\\\"Integrace AI do vašich pracovních postupů — chatboti, inteligentní automatizace a funkce založené na datech.\\\",\\\"title\\\":\\\"Implementace AI řešení\\\"},{\\\"icon\\\":\\\"/images/icons/dns-services.svg\\\",\\\"text\\\":\\\"Moderní, výkonné webové stránky a aplikace postavené na React, Next.js a TypeScript.\\\",\\\"title\\\":\\\"Vývoj webových stránek\\\"},{\\\"icon\\\":\\\"/images/icons/ibm-watson--machine-learning.svg\\\",\\\"text\\\":\\\"Audity založené na datech, optimalizace výkonu a strategie, která pomůže vaší firmě být vidět.\\\",\\\"title\\\":\\\"SEO a technické poradenství\\\"}],\\\"sidenav\\\":{\\\"footer\\\":{\\\"blurb\\\":\\\"Vytvořeno s 🐞\\\",\\\"icons\\\":{\\\"github\\\":{\\\"alt\\\":\\\"GitHub\\\",\\\"ariaDetails\\\":\\\"Danielův GitHub\\\",\\\"ariaLAbel\\\":\\\"Danielův GitHub\\\",\\\"link\\\":\\\"https://github.com/danielfreire-dev/\\\",\\\"src\\\":\\\"/images/icons/github-square.svg\\\",\\\"title\\\":\\\"Danielův GitHub\\\"},\\\"linkedin\\\":{\\\"alt\\\":\\\"LinkedIn\\\",\\\"ariaDetails\\\":\\\"Danielův LinkedIn\\\",\\\"ariaLAbel\\\":\\\"Danielův LinkedIn\\\",\\\"link\\\":\\\"https://www.linkedin.com/in/danielfreire-swe/\\\",\\\"src\\\":\\\"/images/icons/linkedin.svg\\\",\\\"title\\\":\\\"Danielův LinkedIn\\\"}}},\\\"header\\\":{\\\"role\\\":\\\"webový vývojář\\\",\\\"title\\\":\\\"daniel freire\\\"},\\\"legal\\\":{\\\"impressumLink\\\":\\\"/impressum\\\",\\\"impressumName\\\":\\\"impressum\\\",\\\"privacyLink\\\":\\\"/privacy-policy\\\",\\\"privacyLinkAriaDetails\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyLinkAriaLabel\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyLinkTitle\\\":\\\"Zásady ochrany osobních údajů\\\",\\\"privacyName\\\":\\\"zásady ochrany osobních údajů\\\"},\\\"links\\\":[{\\\"link\\\":\\\"/\\\",\\\"name\\\":\\\"domů\\\"},{\\\"link\\\":\\\"/about\\\",\\\"name\\\":\\\"o mně\\\"},{\\\"link\\\":\\\"/portfolio\\\",\\\"name\\\":\\\"portfolio\\\"},{\\\"link\\\":\\\"/contact\\\",\\\"name\\\":\\\"kontakt\\\"}],\\\"privacy\\\":\\\"zásady ochrany osobních údajů\\\",\\\"rights\\\":\\\"Daniel Freire ® všechna práva vyhrazena\\\",\\\"select\\\":{\\\"languageSelectAriaLabel\\\":\\\"Menu pro výběr jazyka\\\",\\\"languageSelectTitle\\\":\\\"Menu pro výběr jazyka\\\"}},\\\"tech\\\":[{\\\"link\\\":\\\"https://nextjs.org\\\",\\\"logo\\\":\\\"/images/icons/nextjs-13.svg\\\",\\\"name\\\":\\\"next.js\\\",\\\"svgr\\\":\\\"Nextjs\\\"},{\\\"link\\\":\\\"https://react.dev\\\",\\\"logo\\\":\\\"/images/icons/react2.svg\\\",\\\"name\\\":\\\"react.js\\\",\\\"svgr\\\":\\\"Reactjs\\\"},{\\\"link\\\":\\\"https://nodejs.org/en\\\",\\\"logo\\\":\\\"/images/icons/node-js.svg\\\",\\\"name\\\":\\\"node.js\\\",\\\"svgr\\\":\\\"Nodejs\\\"},{\\\"link\\\":\\\"https://www.typescriptlang.org\\\",\\\"logo\\\":\\\"/images/icons/Typescript.svg\\\",\\\"name\\\":\\\"typeScript\\\",\\\"svgr\\\":\\\"TypeScript\\\"},{\\\"link\\\":\\\"https://developer.mozilla.org/en-US/docs/Web/JavaScript\\\",\\\"logo\\\":\\\"/images/icons/javascript-original.svg\\\",\\\"name\\\":\\\"javaScript\\\",\\\"svgr\\\":\\\"JavaScript\\\"},{\\\"link\\\":\\\"https://www.w3.org/html/\\\",\\\"logo\\\":\\\"/images/icons/html5-original-wordmark.svg\\\",\\\"name\\\":\\\"HTML5\\\",\\\"svgr\\\":\\\"HTML5\\\"},{\\\"link\\\":\\\"https://developer.mozilla.org/en-US/docs/Web/CSS\\\",\\\"logo\\\":\\\"/images/icons/Official_CSS_Logo.svg\\\",\\\"name\\\":\\\"CSS3\\\",\\\"svgr\\\":\\\"CSS3\\\"},{\\\"link\\\":\\\"https://www.postgresql.org\\\",\\\"logo\\\":\\\"/images/icons/postgresql.svg\\\",\\\"name\\\":\\\"postgreSQL\\\",\\\"svgr\\\":\\\"PostgreSQL\\\"},{\\\"link\\\":\\\"https://vite.dev\\\",\\\"logo\\\":\\\"/images/icons/vitejs.svg\\\",\\\"name\\\":\\\"vite.js\\\",\\\"svgr\\\":\\\"Vitejs\\\"},{\\\"link\\\":\\\"https://webpack.js.org/\\\",\\\"logo\\\":\\\"/images/icons/webpack.svg\\\",\\\"name\\\":\\\"webpack\\\",\\\"svgr\\\":\\\"Webpack\\\"},{\\\"link\\\":\\\"https://github.com/\\\",\\\"logo\\\":\\\"/images/icons/github.svg\\\",\\\"name\\\":\\\"gitHub\\\",\\\"svgr\\\":\\\"Github\\\"},{\\\"link\\\":\\\"https://git-scm.com/\\\",\\\"logo\\\":\\\"/images/icons/git-scm-icon.svg\\\",\\\"name\\\":\\\"git\\\",\\\"svgr\\\":\\\"Git\\\"},{\\\"link\\\":\\\"https://vitest.dev/\\\",\\\"logo\\\":\\\"/images/icons/vitest.svg\\\",\\\"name\\\":\\\"vitest\\\",\\\"svgr\\\":\\\"Vitest\\\"},{\\\"link\\\":\\\"https://jestjs.io/\\\",\\\"logo\\\":\\\"/images/icons/jestjsio-icon.svg\\\",\\\"name\\\":\\\"jest\\\",\\\"svgr\\\":\\\"Jest\\\"},{\\\"link\\\":\\\"https://selenium-python.readthedocs.io/\\\",\\\"logo\\\":\\\"/images/icons/selenium.svg\\\",\\\"name\\\":\\\"selenium\\\",\\\"svgr\\\":\\\"Selenium\\\"},{\\\"link\\\":\\\"https://www.python.org/\\\",\\\"logo\\\":\\\"/images/icons/python-original.svg\\\",\\\"name\\\":\\\"python\\\",\\\"svgr\\\":\\\"Python\\\"},{\\\"link\\\":\\\"https://www.linux.org/\\\",\\\"logo\\\":\\\"/images/icons/linux-original.svg\\\",\\\"name\\\":\\\"linux\\\",\\\"svgr\\\":\\\"Linux\\\"}],\\\"topMainPage\\\":{\\\"blurbsArray\\\":[{\\\"description\\\":\\\"Brzdí váš web růst vašeho podnikání? Náš komplexní audit výkonnosti důkladně analyzuje vaši technickou infrastrukturu, uživatelskou zkušenost a konverzní potenciál. Poskytneme vám podrobnou zprávu s klíčovými vylepšeními, která mohou dramaticky zvýšit váš online výkon.\\\",\\\"title\\\":\\\"Revolucionizujte svou digitální přítomnost hned teď!\\\"},{\\\"description\\\":\\\"Webové stránky vyžadují neustálou péči, aby zůstaly bezpečné, funkční a konkurenceschopné. Naše komplexní balíčky údržby nabízejí proaktivní monitorování, okamžité řešení problémů a průběžné technologické aktualizace.\\\",\\\"title\\\":\\\"Odemkněte plný potenciál svého webu\\\"},{\\\"description\\\":\\\"Přestaňte se spokojovat s obecnými šablonami. Naše služby vývoje webu na míru vytvářejí plně přizpůsobená digitální prostředí, která dokonale odpovídají jedinečné identitě vaší značky a vašim obchodním cílům. Proměníme váš koncept ve výkonné, responzivní a moderní webové řešení.\\\",\\\"title\\\":\\\"Postavte si svůj vysněný projekt ještě dnes\\\"},{\\\"description\\\":\\\"Rychlost není jen funkce – je to konkurenční výhoda. Naše služba optimalizace výkonu zajišťuje extrémně rychlé načítání vašeho webu, což přináší výjimečnou uživatelskou zkušenost, která udrží návštěvníky a efektivněji je konvertuje.\\\",\\\"title\\\":\\\"Zrychlete potenciál svého webu\\\"},{\\\"description\\\":\\\"Technologie se vyvíjejí rychle. Naše specializované migrační služby vám pomohou plynule přejít na moderní, efektivní webové technologie bez narušení vašich stávajících operací. Zajišťujeme hladký a řízený upgrade s minimem rizik.\\\",\\\"title\\\":\\\"Modernizujte svou digitální infrastrukturu\\\"},{\\\"description\\\":\\\"Webové stránky vyžadují neustálou péči, aby zůstaly bezpečné, funkční a konkurenceschopné. Naše komplexní balíčky údržby nabízejí proaktivní monitorování, okamžité řešení problémů a průběžné technologické aktualizace.\\\",\\\"title\\\":\\\"Průběžná péče o vaše digitální aktiva\\\"}],\\\"p1\\\":\\\"Už vás nebaví software, který vás ve vašem podnikání brzdí?\\\",\\\"p2\\\":\\\"Většina podnikového softwaru je buď příliš rigidní, nebo příliš složitá. Specializuji se na vývoj vlastních webových aplikací – jako jsou CRM systémy, sledování projektů a datové přehledy – které přesně odpovídají tomu, jak vaše firma skutečně funguje. Pokud potřebujete nástroj, který řeší konkrétní problém bez zbytečných funkcí, pojďme probrat, čeho chcete dosáhnout.\\\"}},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"Europe/Lisbon\\\",\\\"children\\\":\\\"$L15\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"16:I[59,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"Providers\\\"]\\n17:I[5564,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"default\\\"]\\n18:I[4275,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"530\\\",\\\"static/chunks/app/%5Blocale%5D/error-8ecce493219f8816.js\\\"],\\\"default\\\"]\\n15:[\\\"$\\\",\\\"$L16\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"flex flex-row\\\",\\\"children\\\":[\\\"$\\\",\\\"$L17\\