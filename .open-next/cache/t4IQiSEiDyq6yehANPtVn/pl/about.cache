shoffset\" begin=\"1.4s\" dur=\"0.2s\" values=\"2;0\"></animate></path><animateTransform attributeName=\"transform\" dur=\"30s\" repeatCount=\"indefinite\" type=\"rotate\" values=\"0 12 12;360 12 12\"></animateTransform></g><g fill=\"#ff8000\"><path d=\"M15.22 6.03L17.75 4.09L14.56 4L13.5 1L12.44 4L9.25 4.09L11.78 6.03L10.87 9.09L13.5 7.28L16.13 9.09L15.22 6.03Z\"><animate fill=\"freeze\" attributeName=\"fill-opacity\" dur=\"0.4s\" values=\"1;0\"></animate></path><path d=\"M19.61 12.25L21.25 11L19.19 10.95L18.5 9L17.81 10.95L15.75 11L17.39 12.25L16.8 14.23L18.5 13.06L20.2 14.23L19.61 12.25Z\"><animate fill=\"freeze\" attributeName=\"fill-opacity\" begin=\"0.2s\" dur=\"0.4s\" values=\"1;0\"></animate></path></g><path fill=\"#ff8000\" stroke=\"#ff8000\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 6 C7 12.08 11.92 17 18 17 C18.53 17 19.05 16.96 19.56 16.89 C17.95 19.36 15.17 21 12 21 C7.03 21 3 16.97 3 12 C3 8.83 4.64 6.05 7.11 4.44 C7.04 4.95 7 5.47 7 6 Z\"><set fill=\"freeze\" attributeName=\"opacity\" begin=\"0.6s\" to=\"0\"></set></path><mask id=\"lineMdMoonFilledToSunnyFilledLoopTransition0\"><circle cx=\"12\" cy=\"12\" r=\"12\" fill=\"#fff\"></circle><circle cx=\"18\" cy=\"6\" r=\"12\" fill=\"#fff\"><animate fill=\"freeze\" attributeName=\"cx\" begin=\"0.6s\" dur=\"0.4s\" values=\"18;22\"></animate><animate fill=\"freeze\" attributeName=\"cy\" begin=\"0.6s\" dur=\"0.4s\" values=\"6;2\"></animate><animate fill=\"freeze\" attributeName=\"r\" begin=\"0.6s\" dur=\"0.4s\" values=\"12;3\"></animate></circle><circle cx=\"18\" cy=\"6\" r=\"10\"><animate fill=\"freeze\" attributeName=\"cx\" begin=\"0.6s\" dur=\"0.4s\" values=\"18;22\"></animate><animate fill=\"freeze\" attributeName=\"cy\" begin=\"0.6s\" dur=\"0.4s\" values=\"6;2\"></animate><animate fill=\"freeze\" attributeName=\"r\" begin=\"0.6s\" dur=\"0.4s\" values=\"10;1\"></animate></circle></mask><circle cx=\"12\" cy=\"12\" r=\"10\" mask=\"url(#lineMdMoonFilledToSunnyFilledLoopTransition0)\" opacity=\"0\" fill=\"#ff8000\"><animate fill=\"freeze\" attributeName=\"r\" begin=\"0.6s\" dur=\"0.4s\" values=\"10;6\"></animate><set fill=\"freeze\" attributeName=\"opacity\" begin=\"0.6s\" to=\"1\"></set></circle></svg></div></label></div><footer class=\"flex justify-center mt-2 whitespace-pre-wrap\" aria-label=\"footer\" aria-details=\"footer\" role=\"contentinfo\">Stworzone z 🐞 przez<!-- --> <a href=\"https://github.com/danielfreire-dev/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"underline capitalize\" aria-label=\"Daniel Freire&#x27;s GitHub\" title=\"Daniel Freire&#x27;s GitHub\" aria-details=\"Daniel Freire&#x27;s GitHub\">daniel freire</a></footer><div class=\"flex flex-nowrap justify-center capitalize underline italic\"><a aria-label=\"Polityka Prywatności\" title=\"Polityka Prywatności\" aria-details=\"Polityka Prywatności\" class=\"truncate\" href=\"/pl/polityka-prywatnosci\">polityka prywatności</a></div></section></nav><input type=\"checkbox\" id=\"slide-menu\" class=\"hidden appearance-none\" aria-label=\"Close menu\" name=\"slide-menu\" checked=\"\"/><label for=\"slide-menu\" aria-label=\"Close menu\" class=\"lg:hidden fixed top-2 z-50 p-1.5 hover:bg-(--surface) text-(--text-hover)\n\t\t\t\ttransform transition-transform duration-550 ease-in-out\n\t\t\t\ttranslate-x-56\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1.5em\" height=\"1.5em\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"><path d=\"M5 12H19\"><animate fill=\"freeze\" attributeName=\"d\" dur=\"0.4s\" values=\"M5 12H19;M12 12H12\"></animate><set fill=\"freeze\" attributeName=\"opacity\" begin=\"0.4s\" to=\"0\"></set></path><path d=\"M5 5L19 5M5 19L19 19\" opacity=\"0\"><animate fill=\"freeze\" attributeName=\"d\" begin=\"0.2s\" dur=\"0.4s\" values=\"M5 5L19 5M5 19L19 19;M5 5L19 19M5 19L19 5\"></animate><set fill=\"freeze\" attributeName=\"opacity\" begin=\"0.2s\" to=\"1\"></set></path></g></svg></label></header><main class=\"flex flex-1 justify-center flex-col overflow-hidden pb-5 mt-9\"><div id=\"main\"><div class=\"px-20 lg:grid lg:grid-cols-2 gap-6 focus-in-expand\"><img alt=\"oil painting of Daniel\" loading=\"lazy\" width=\"900\" height=\"900\" decoding=\"async\" data-nimg=\"1\" class=\"hidden lg:block mt-4\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2FLensa%2FLensa2.webp&amp;w=1080&amp;q=75 1x, /_next/image?url=%2Fimages%2FLensa%2FLensa2.webp&amp;w=1920&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2FLensa%2FLensa2.webp&amp;w=1920&amp;q=75\"/><div class=\"text-justify\"><h2 class=\"\">Budowanie dla Człowieka Za Ekranem</h2><p class=\"mb-2\">Od dwóch lat tworzę rzeczy w sieci. Ale moja perspektywa na to, co budować i dlaczego, ukształtowała się na długo przed napisaniem pierwszej linijki kodu.</p><p class=\"mb-2\">Wszedłem do tej branży z marketingu, ale nie z tej strony, którą możesz sobie wyobrażać. Mój świat był mniej o kampaniach, a więcej o wzorcach: analizowaniu danych rynkowych, rozszyfrowywaniu zachowań użytkowników i zrozumieniu precyzyjnych mechanizmów, w jaki sposób ludzie znajdują i korzystają z produktu online. SEO i SEM, w swojej istocie, to po prostu zastosowana psychologia i rozwiązywanie problemów. Uczysz się słuchać, co dane krzyczą, a co ważniejsze, co szepczą.</p><p class=\"mb-2\">To jest tło, które wniosę do każdego projektu developerskiego. Większość developerów potrafi pisać elegancki kod; moim skupieniem jest budowanie eleganckich rozwiązań. Jest tu kluczowa różnica.</p><p class=\"mb-2\">Kiedy projektuję aplikację w React czy Next.js, nie myślę tylko o zarządzaniu stanem czy strukturze komponentów. Myślę o podróży użytkownika, która go tu przywiodła. Rozważam semantyczny znacznik, który nadaje naszej treści znaczenie wykraczające poza ekran. Buduję z wrodzonym zrozumieniem wydajności, ponieważ wiem z pierwszej ręki, że opóźnienie nawet o pół sekundy to decyzja użytkownika o opuszczeniu strony.</p><p class=\"mb-2\">Oto, w czym błądzi wielu utalentowanych developerów: budują dla urządzenia. Budują zgodnie ze specyfikacją. Ale zapominają budować dla człowieka po drugiej stronie i dla celu biznesowego, który czyni projekt wartym zachodu. Moje doświadczenie pozwala mi funkcjonować na tym przecięciu. Potrafię przetłumaczyć potrzebę biznesową na wymaganie techniczne nie jako abstrakcyjny koncept, lecz jako przeżyte doświadczenie. Byłem osobą proszącą o dane, a teraz jestem osobą budującą systemy, które je dostarczają.</p><p class=\"mb-2\">Niezależnie od tego, czy to elegancki front-end, solidny panel admina Django czy pełna aplikacja full-stack w Node.js, pytanie, od którego zawsze zaczynam, brzmi: &quot;Co tak naprawdę rozwiązujemy?&quot; Technologia jest środkiem do celu. Prawdziwe kunszt polega na wyborze właściwego narzędzia do pracy i używaniu go z mądrością płynącą ze zrozumienia, na czym ta praca tak naprawdę polega.</p><p class=\"mb-2\">Nie tylko buduję rzeczy poprawnie. Buduję właściwe rzeczy.</p></div></div><!--$--><!--$--><a class=\"truncate\" href=\"/pl/kontakt\"><button class=\"button-class offset overflow-hidden text-ellipsis whitespace-nowrap hover:cursor-pointer\">Porozmawiajmy o Twoim biznesie</button></a><!--/$--><!--/$--><!--$--><!--/$--></div></main><script src=\"/_next/static/chunks/webpack-2c576fa73dacc87e.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[819,[],\\\"\\\"]\\n3:I[4271,[],\\\"\\\"]\\n6:I[7514,[],\\\"OutletBoundary\\\"]\\n8:I[4751,[],\\\"AsyncMetadataOutlet\\\"]\\na:I[7514,[],\\\"ViewportBoundary\\\"]\\nc:I[7514,[],\\\"MetadataBoundary\\\"]\\nd:\\\"$Sreact.suspense\\\"\\nf:I[5865,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/03734ca0d655c7fc-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/91b5bf6d44e5eed0-s.p.ttf\\\",\\\"font\\\",{\\\"crossO