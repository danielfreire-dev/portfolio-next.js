ks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/%5Blocale%5D/error-8ecce493219f8816.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>O Mnie | Daniel Freire</title><meta name=\"description\" content=\"Dowiedz się więcej o Danielu\"/><link rel=\"author\" href=\"https://daniel-freire.com/\"/><meta name=\"author\" content=\"Daniel Freire\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"keywords\" content=\"Daniel Freire,Portfolio,Next.js,React,TypeScript,JavaScript,Digital Marketing\"/><meta name=\"creator\" content=\"Daniel Freire\"/><link rel=\"canonical\" href=\"https://www.daniel-freire.com/about\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"https://daniel-freire.com/en/about\"/><link rel=\"alternate\" hrefLang=\"pt\" href=\"https://daniel-freire.com/pt/sobre\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Daniel Freire\"/><meta property=\"og:description\" content=\"Dowiedz się więcej o Danielu\"/><meta property=\"og:url\" content=\"https://daniel-freire.com\"/><meta property=\"og:site_name\" content=\"O Mnie\"/><meta property=\"og:locale\" content=\"pl\"/><meta property=\"og:image\" content=\"https://daniel-freire.com/metadata/open-graph-initials5.png\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Daniel Freire\"/><meta name=\"twitter:description\" content=\"Dowiedz się więcej o Danielu\"/><meta name=\"twitter:image\" content=\"https://daniel-freire.com/metadata/open-graph-initials5.png\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"242x242\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_440f51 __variable_fb4fc1 __variable_454bfa __variable_5db66a __variable_f35245 antialiased