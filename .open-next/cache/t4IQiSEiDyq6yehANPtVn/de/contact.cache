ody{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\\\"}}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"next-error-h1\\\",\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\",\\\"margin\\\":\\\"0 20px 0 0\\\",\\\"padding\\\":\\\"0 23px 0 0\\\",\\\"fontSize\\\":24,\\\"fontWeight\\\":500,\\\"verticalAlign\\\":\\\"top\\\",\\\"lineHeight\\\":\\\"49px\\\"},\\\"children\\\":404}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\"},\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":14,\\\"fontWeight\\\":400,\\\"lineHeight\\\":\\\"49px\\\",\\\"margin\\\":0},\\\"children\\\":\\\"This page could not be found.\\\"}]}]]}]}]],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],{\\\"children\\\":[[\\\"locale\\\",\\\"de\\\",\\\"d\\\"],[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/1029e7e837152b2c.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],\\\"$L4\\\"]}],{\\\"children\\\":[\\\"contact\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L3\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],{\\\"children\\\":[\\\"__PAGE__\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$L5\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/6f38da81924774e7.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L6\\\",null,{\\\"children\\\":[\\\"$L7\\\",[\\\"$\\\",\\\"$L8\\\",null,{\\\"promise\\\":\\\"$@9\\\"}]]}]]}],{},null,false]},null,false]},null,false]},null,false],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[[\\\"$\\\",\\\"$La\\\",null,{\\\"children\\\":\\\"$Lb\\\"}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$Lc\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$d\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$Le\\\"}]}]}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$f\\\",[]],\\\"s\\\":false,\\\"S\\\":true}\\n\"])</script><script>self.__next_f.push([1,\"10:I[7134,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"638\\\",\\\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\\\"],\\\"default\\\"]\\n5:[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mx-auto text-center capitalize mb-4\\\",\\\"children\\\":\\\"Kontakt\\\"}],[\\\"$\\\",\\\"$L10\\\",null,{}]]\\n\"])</script><script>self.__next_f.push([1,\"11:I[944,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"SpeedInsights\\\"]\\n12:I[3942,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"default\\\"]\\n4:[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"de\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",null,{}],[\\\"$\\\",\\\"$d\\\",null,{\\\"fallback\\\":null,\\\"children\\\":[\\\"$\\\",\\\"$L12\\\",null,{\\\"GA_MEASUREMENT_ID\\\":\\\"G-0LCR929FXK\\\"}]}],[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"__variable_440f51 __variable_fb4fc1 __variable_454bfa __variable_5db66a __variable_f35245 antialiased flex min-h-screen selection:bg-(--primary) selection:text-(--selector-txt) \\\",\\\"children\\\":\\\"$L13\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"14:I[8353,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"638\\\",\\\"static/chunks/app/%5Blocale%5D/contact/page-bd4e0fbd26feff6b.js\\\"],\\\"default\\\"]\\n\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"$L14\\\",null,{\\\"formats\\\":\\\"$undefined\\\",\\\"locale\\\":\\\"de\\\",\\\"messages\\\":{\\\"about\\\":{\\\"image\\\":\\\"/images/Lensa/Lensa2.webp\\\",\\\"paragraph1\\\":\\\"In den letzten zwei Jahren habe ich Dinge im Web gebaut. Aber meine Perspektive darauf, was gebaut werden sollte und warum, wurde lange vor meiner ersten Codezeile geprägt.\\\",\\\"paragraph2\\\":\\\"Ich bin über das Marketing zu diesem Feld gekommen, aber nicht von der Seite, die Sie sich vielleicht vorstellen. Meine Welt drehte sich weniger um Kampagnen und mehr um Muster: die Analyse von Marktdaten, die Entschlüsselung von Nutzerverhalten und das Verständnis der genauen Mechanismen, wie Menschen ein Produkt online finden und nutzen. SEO und SEM sind im Kern nichts anderes als angewandte Psychologie und Problemlösung. Man lernt, auf das zu hören, was die Daten schreien, und noch wichtiger, auf das, was sie flüstern.\\\",\\\"paragraph3\\\":\\\"Das ist der Hintergrund, den ich in jedes Entwicklungsprojekt einbringe. Die meisten Entwickler können eleganten Code schreiben; mein Fokus liegt darauf, elegante Lösungen zu bauen. Das ist ein entscheidender Unterschied.\\\",\\\"paragraph4\\\":\\\"Wenn ich eine Anwendung mit React oder Next.js architekturiere, denke ich nicht nur an State-Management oder Komponentenstruktur. Ich denke an die Reise des Nutzers, die ihn dorthin geführt hat. Ich berücksichtige das semantische Markup, das unserem Inhalte eine Bedeutung jenseits des Bildschirms verleiht. Ich baue mit einem angeborenen Verständnis für Performance, weil ich aus erster Hand weiß, dass eine Verzögerung von nur einer halben Sekunde eine Entscheidung des Nutzers ist, die Seite zu verlassen.\\\",\\\"paragraph5\\\":\\\"Hier liegt der Fehler, den viele talentierte Entwickler machen: Sie bauen für das Gerät. Sie bauen für die Spezifikation. Aber sie vergessen, für den Menschen auf der anderen Seite und für das Geschäftsziel zu bauen, das das Projekt überhaupt lohnenswert macht. Meine Erfahrung erlaubt es mir, an dieser Schnittstelle zu sitzen. Ich kann ein Geschäftsbedürfnis in eine technische Anforderung übersetzen, nicht als abstraktes Konzept, sondern als gelebte Erfahrung. Ich war die Person, die nach den Daten fragt, und jetzt bin die Person, die die Systeme baut, die sie liefern.\\\",\\\"paragraph6\\\":\\\"Egal ob ein elegantes Frontend, ein robustes Django-Admin oder eine Full-Stack-Node.js-Anwendung – die Frage, mit der ich immer beginne, lautet: \\\\\\\"Was lösen wir eigentlich?\\\\\\\" Die Technologie ist ein Mittel zum Zweck. Die wahre Kunst liegt darin, das richtige Werkzeug für die Aufgabe zu wählen und es mit der Weisheit einzusetzen, zu wissen, was diese Aufgabe wirklich ist.\\\",\\\"paragraph7\\\":\\\"Ich baue Dinge nicht nur richtig. Ich baue die richtigen Dinge.\\\",\\\"title1\\\":\\\"Bauen für den Menschen hinter dem Bildschirm\\\"},\\\"carousel\\\":[{\\\"alt\\\":\\\"Revolutionieren Sie jetzt Ihre digitale Präsenz!\\\",\\\"cta\\\":\\\"Revolutionieren Sie Ihre digitale Präsenz!\\\",\\\"description\\\":\\\"Hält Ihre Website Ihr Unternehmen zurück? Unser umfassender Performance-Audit taucht tief in die technische Infrastruktur Ihrer Website, die Nutzererfahrung und das Conversion-Potenzial ein. Wir liefern einen detaillierten Bericht, der kritische Verbesserungen aufzeigt, die Ihre Online-Leistung dramatisch steigern können.\\\",\\\"id\\\":1,\\\"imageUrl\\\":\\\"/images/Carousel/white.webp\\\",\\\"loading\\\":\\\"lazy\\\",\\\"title\\\":\\\"revolutionieren sie jetzt ihre digitale präsenz!\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Entfalten Sie das volle Potenzial Ihrer Website\\\",\\\"cta\\\":\\\"Entfalten Sie das volle Potenzial Ihrer Website\\\",\\\"description\\\":\\\"Websites benötigen kontinuierliche Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problembehebung und kontinuierliche Technologie-Updates.\\\",\\\"id\\\":2,\\\"imageUrl\\\":\\\"/images/Carousel/umbrellas.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"entfalten sie das volle potenzial ihrer website\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Bauen Sie Ihr Traumprojekt noch heute\\\",\\\"cta\\\":\\\"Bauen Sie Ihr Traumprojekt noch heute\\\",\\\"description\\\":\\\"Hören Sie auf, sich mit generischen Vorlagen zufriedenzugeben. Unsere maßgeschneiderten Webentwicklungsdienste erstellen vollständig individualisierte digitale Erlebnisse, die perfekt auf die einzigartige Identität Ihrer Marke und Ihre Geschäftsziele abgestimmt sind. Wir verwandeln Ihr Konzept in eine leistungsstarke, responsive und zukunftsweisende Web-Lösung.\\\",\\\"id\\\":3,\\\"imageUrl\\\":\\\"/images/Carousel/estatuas.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"bauen sie ihr traumprojekt noch heute\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Machen Sie den ersten Schritt in Richtung digitale Exzellenz\\\",\\\"cta\\\":\\\"Machen Sie den ersten Schritt\\\",\\\"description\\\":\\\"Geschwindigkeit ist nicht nur ein Feature – sie ist ein Wettbewerbsvorteil. Unser Performance-Optimierungsservice sorgt dafür, dass Ihre Website blitzschnell lädt und ein außergewöhnliches Nutzererlebnis bietet, das Besucher bindet und effektiver konvertiert.\\\",\\\"id\\\":4,\\\"imageUrl\\\":\\\"/images/Carousel/building-orange.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"beschleunigen sie das potenzial ihrer website\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Modernisieren Sie Ihre digitale Infrastruktur\\\",\\\"cta\\\":\\\"Modernisieren Sie Ihre digitale Infrastruktur\\\",\\\"description\\\":\\\"Die Technologie entwickelt sich rasant. Unsere Expertendienste für Migration helfen Ihnen, nahtlos auf moderne, effiziente Webtechnologien umzusteigen, ohne Ihren bestehenden Betrieb zu stören. Wir gewährleisten einen reibungslosen, risikomanagierten Upgrade-Pfad.\\\",\\\"id\\\":5,\\\"imageUrl\\\":\\\"/images/Carousel/building-yellow.webp\\\",\\\"loading\\\":\\\"eager\\\",\\\"title\\\":\\\"modernisieren sie ihre digitale infrastruktur\\\",\\\"url\\\":\\\"/contact\\\"},{\\\"alt\\\":\\\"Bleistifte\\\",\\\"cta\\\":\\\"Kümmern Sie sich um Ihre digitalen Assets\\\",\\\"description\\\":\\\"Websites benötigen kontinuierliche Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problembehebung und kontinuierliche Technologie-Updates.\\\",\\\"id\\\":6,\\\"imageUrl\\\":\\\"/images/Carousel/pencils.webp\\\",\\\"loading\\\":\\\"lazy\\\",\\\"title\\\":\\\"kontinuierliche pflege für ihre digitalen assets\\\",\\\"url\\\":\\\"/contact\\\"}],\\\"contact\\\":{\\\"btn\\\":\\\"Nachricht senden\\\",\\\"email\\\":\\\"E-Mail\\\",\\\"farewell\\\":{\\\"text\\\":\\\"Ich schätze Ihr Vertrauen. Sie können eine Antwort innerhalb der nächsten Werktage erwarten.\\\",\\\"title\\\":\\\"danke\\\"},\\\"firstName\\\":\\\"Vorname\\\",\\\"label\\\":\\\"Ich habe gelesen und stimme zu mit \\\",\\\"lastName\\\":\\\"Nachname\\\",\\\"message\\\":\\\"Nachricht\\\",\\\"pageTitle\\\":\\\"Kontakt\\\",\\\"phone\\\":\\\"Telefonnummer\\\",\\\"placeholder\\\":{\\\"email\\\":\\\"Geben Sie Ihre E-Mail ein\\\",\\\"firstName\\\":\\\"Geben Sie Ihren Vornamen ein\\\",\\\"lastName\\\":\\\"Geben Sie Ihren Nachnamen ein\\\",\\\"message\\\":\\\"Geben Sie Ihre Nachricht ein\\\",\\\"phone\\\":\\\"Geben Sie Ihre Telefonnummer ein\\\"},\\\"privacy\\\":\\\"Datenschutzerklärung\\\",\\\"privacyPolicyCheck\\\":\\\"Ich bestätige, dass ich gelesen habe und der\\\",\\\"privacyPolicyUrl\\\":\\\"datenschutz/\\\",\\\"privacyPolicyUrlAriaDetails\\\":\\\"Datenschutzerklärung\\\",\\\"privacyPolicyUrlAriaLabel\\\":\\\"Datenschutzerklärung\\\",\\\"privacyPolicyUrlTitle\\\":\\\"Datenschutzerklärung\\\",\\\"required\\\":\\\"erforderlich\\\",\\\"title\\\":\\\"Kontakt aufnehmen\\\"},\\\"cookies\\\":{\\\"buttonText\\\":\\\"Alle akzeptieren\\\",\\\"declineButtonText\\\":\\\"Alle ablehnen\\\",\\\"manageAdvertSubtitle\\\":\\\"Personalisieren Sie Werbung und messen Sie deren Leistung\\\",\\\"manageAdvertTitle\\\":\\\"Werbung\\\",\\\"manageAnalyticsSubtitle\\\":\\\"Helfen Sie uns zu verstehen, wie Besucher mit unserer Website interagieren\\\",\\\"manageAnalyticsTitle\\\":\\\"Analytik\\\",\\\"manageButtonText\\\":\\\"Cookies verwalten\\\",\\\"manageCancelButtonText\\\":\\\"Abbrechen\\\",\\\"manageCookiesStatus\\\":\\\"Status: {{status}} am {{date}}\\\",\\\"manageCookiesStatusConsented\\\":\\\"Zugestimmt\\\",\\\"manageCookiesStatusDeclined\\\":\\\"Abgelehnt\\\",\\\"manageEssentialStatus\\\":\\\"Status: Immer aktiviert\\\",\\\"manageEssentialStatusButtonText\\\":\\\"Analytik\\\",\\\"manageEssentialSubtitle\\\":\\\"Erforderlich für die ordnungsgemäße Funktion der Website\\\",\\\"manageEssentialTitle\\\":\\\"Essenziell\\\",\\\"manageMessage\\\":\\\"Verwalten Sie Ihre Cookie-Einstellungen unten. Essenzielle Cookies sind immer aktiviert, da sie für die ordnungsgemäße Funktion der Website notwendig sind.\\\",\\\"manageSaveButtonText\\\":\\\"Einstellungen speichern\\\",\\\"manageSocialSubtitle\\\":\\\"Aktivieren Sie Social-Media-Funktionen und Teilen\\\",\\\"manageSocialTitle\\\":\\\"Social\\\",\\\"manageTitle\\\":\\\"Cookie-Einstellungen\\\",\\\"message\\\":\\\"Wir schätzen Ihre Privatsphäre. Wählen Sie aus, welche Cookies Sie zulassen möchten. Essenzielle Cookies sind immer aktiviert, da sie für die ordnungsgemäße Funktion der Website notwendig sind.\\\",\\\"privacyPolicyText\\\":\\\"Datenschutzerklärung\\\",\\\"privacyurl\\\":\\\"/de/datenschutz\\\",\\\"title\\\":\\\"Möchten Sie ein Cookie? 🍪\\\"},\\\"cta\\\":{\\\"blurb\\\":\\\"Haben Sie ein Projekt im Sinn? Lassen Sie uns plaudern.\\\",\\\"button\\\":[\\\"Lassen Sie uns über Ihr Unternehmen sprechen\\\",\\\"Haben Sie ein Projekt im Sinn? Lassen Sie uns plaudern.\\\",\\\"Suchen Sie einen Front-End-Entwickler? Sie haben einen gefunden!\\\",\\\"Sagen Sie Hallo — ich beiße nicht 👋\\\",\\\"Machen wir Ihre Website unvergesslich →\\\",\\\"Brauchen Sie einen Entwickler, der liefert? Lassen Sie uns reden.\\\",\\\"Lassen Sie uns zusammen etwas Großartiges bauen →\\\"],\\\"title\\\":\\\"Kontakt aufnehmen\\\"},\\\"email\\\":{\\\"email\\\":\\\"hello@daniel-freire.com\\\",\\\"message\\\":\\\"zufällige Nachricht\\\",\\\"title\\\":\\\"💻🚀 Hallo\\\",\\\"welcome\\\":{\\\"conclusion\\\":\\\"Das ist mehr als eine Website – es ist Ihr digitaler Händedruck, Ihr erster Eindruck und Ihre Chance, sich in einem überfüllten Feld zu profilieren. Lassen Sie uns sie unvergesslich machen.\\\",\\\"happensNext0\\\":\\\"Hier ist, was als Nächstes passiert:\\\",\\\"happensNext1\\\":\\\"Ich werde Ihre Einsendung persönlich prüfen und innerhalb von 2–3 Werktagen mit einem maßgeschneiderten Plan (oder Fragen zur Präzisierung des Umfangs) antworten.\\\",\\\"happensNext2\\\":\\\"In den nächsten Werktagen hören Sie von mir mit klaren nächsten Schritten, Zeitplänen und Informationen, wie wir zusammenarbeiten werden, um Ihre Vision zum Leben zu erwecken.\\\",\\\"happensNext3\\\":\\\"Wenn Sie bis dahin keine E-Mail von mir sehen, zögern Sie nicht, nachzufassen – ich stecke entweder tief im Code oder kämpfe mit meinem Posteingang (und ich werde Ihr Projekt immer priorisieren).\\\",\\\"heading\\\":\\\"Hallo\\\",\\\"intro\\\":\\\"Beginnen wir mit einer einfachen Wahrheit: Der Aufbau einer Online-Präsenz, die Ihre Dienstleistungen/Fähigkeiten als Profi wirklich repräsentiert, erfordert Mut und Weitsicht. Die Tatsache, dass Sie hier sind – und konkrete Schritte unternehmen, um Ihre Arbeit zu verbessern – sagt viel über Ihr Engagement für Wachstum aus. Das ist es wert, gefeiert zu werden.\\\",\\\"introduction\\\":\\\"Ich bin Daniel Freire und ich habe mich auf die Erstellung von hochwirksamen, kundenfokussierten Websites spezialisiert, die nicht nur Projekte anzeigen, sondern eine überzeugende Geschichte darüber erzählen, was Sie beitragen. Egal, ob Sie darauf abzielen, Spitzenkunden zu gewinnen, Ihren Traumjob zu landen oder einfach Ihr Fachwissen mit Klarheit und Stil zu präsentieren – Ihre Website ist Ihr mächtigstes Werkzeug. Und ich bin hier, um Ihnen zu helfen, es zu schärfen.\\\",\\\"name\\\":\\\"Daniel Freire\\\",\\\"preview\\\":\\\"Daniel Freires Willkommens-E-Mail\\\",\\\"privacyPolicy\\\":\\\"Datenschutzerklärung\\\",\\\"privacyPolicyUrl\\\":\\\"de/datenschutz/\\\",\\\"signature\\\":\\\"Ich freue mich auf die Zusammenarbeit mit Ihnen,\\\",\\\"view\\\":\\\"Sehen Sie sich die\\\",\\\"webLink\\\":\\\"daniel-freire.com\\\",\\\"whileWait0\\\":\\\"Während Sie warten, können Sie gerne:\\\",\\\"whileWait1\\\":\\\"✅ Auf diese E-Mail mit zusätzlichen Gedanken antworten – wie bestimmte Projekte, auf die Sie stolz sind, Designpräferenzen oder Ziele für Ihre Website (z. B. „Ich möchte, dass Personalvermittler sofort meine Full-Stack-Expertise sehen“).\\\",\\\"whileWait2\\\":\\\"✅ Assets sammeln (GitHub-Links, Fallstudien oder sogar grobe Skizzen), um den Prozess zu optimieren, sobald wir beginnen.\\\"}},\\\"error\\\":{\\\"404\\\":\\\"404 - Seite nicht gefunden\\\",\\\"back\\\":\\\"Zurück zur Startseite\\\",\\\"description\\\":\\\"Sieht so aus, als hätten Sie sich verirrt. Keine Sorge, das passiert den Besten.\\\",\\\"errorLoading\\\":{\\\"contact\\\":\\\"\\u003cp\\u003eWenn Sie glauben, dass hier eine Seite sein sollte, kontaktieren Sie bitte \\u003ca\\u003ewebmaster@daniel-freire.com\\u003c/a\\u003e\\u003c/p\\u003e\\\",\\\"description\\\":\\\"\\u003cp\\u003eWir sind leider auf einen Fehler gestoßen.\\u003c/p\\u003e\\u003cp\\u003eSie können versuchen, die Seite \\u003cretry\\u003eneu zu laden\\u003c/retry\\u003e, die Sie besucht haben.\\u003c/p\\u003e\\\",\\\"title\\\":\\\"etwas ist schiefgelaufen!\\\"}},\\\"home\\\":{\\\"techstack\\\":\\\"Fähigkeiten \\u0026 Werkzeuge\\\",\\\"trending\\\":\\\"Portfolio\\\"},\\\"icons\\\":{\\\"leftarrow\\\":{\\\"alt\\\":\\\"Pfeil links\\\",\\\"src\\\":\\\"/images/icons/chevron-left.svg\\\"},\\\"rightarrow\\\":{\\\"alt\\\":\\\"Pfeil rechts\\\",\\\"src\\\":\\\"/images/icons/chevron-right.svg\\\"}},\\\"localeSwitcher\\\":{\\\"locale\\\":\\\"{locale, select, pt {🇵🇹 Português} en {🇺🇸 English} dk {🇩🇰 Dansk} pl {🇵🇱 Polski} de {🇩🇪 Deutsch} cz {🇨🇿 Český} other {Unknown}}\\\",\\\"localeMobile\\\":\\\"{locale, select, pt {🇵🇹} en {🇺🇸} dk {🇩🇰} pl {🇵🇱} de {🇩🇪} cz {🇨🇿} other {Unknown}}\\\"},\\\"metadata\\\":{\\\"description\\\":{\\\"about\\\":\\\"Erfahren Sie mehr über Daniel\\\",\\\"contact\\\":\\\"Dies ist der beste Ort, um Daniel zu kontaktieren\\\",\\\"home\\\":\\\"Daniels Vorstellung\\\",\\\"impressum\\\":\\\"\\\",\\\"portfolio\\\":\\\"Hier wird Daniel seine Lieblingsarbeiten veröffentlichen\\\",\\\"privacyPolicy\\\":\\\"Erfahren Sie mehr über Ihre Rechte.\\\"},\\\"name\\\":\\\"Daniel Freire\\\",\\\"opengraphImage\\\":\\\"metadata/open-graph.png\\\",\\\"opengraphImageAlt\\\":\\\"Daniel Freire\\\",\\\"title\\\":{\\\"about\\\":\\\"Über Mich\\\",\\\"contact\\\":\\\"Kontakt\\\",\\\"home\\\":\\\"Startseite | Daniel Freire\\\",\\\"impressum\\\":\\\"Impressum\\\",\\\"portfolio\\\":\\\"Portfolio\\\",\\\"privacyPolicy\\\":\\\"Datenschutzerklärung\\\"},\\\"twitterImage\\\":\\\"metadata/open-graph.png\\\",\\\"twitterImageAlt\\\":\\\"Daniel Freire\\\"},\\\"portfolio\\\":{\\\"all\\\":\\\"Alle\\\",\\\"cta\\\":[\\\"ansehen\\\",\\\"zum Live-Projekt →\\\"],\\\"pageTitle\\\":\\\"portfolio\\\",\\\"projects\\\":[{\\\"github\\\":\\\"https://github.com/danielfreire-dev/Quizzical\\\",\\\"link\\\":\\\"https://quizzicall-bydainelli.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/quizzical.webp\\\",\\\"summary\\\":\\\"Trivia game with 4.000+ questions.\\\",\\\"title\\\":\\\"quizzical\\\"},{\\\"github\\\":\\\"https://github.com/danielfreire-dev/PollyGlot\\\",\\\"link\\\":\\\"https://pollyglot-bydainelli.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/pollyglot.webp\\\",\\\"summary\\\":\\\"Translation app with AI.\\\",\\\"title\\\":\\\"pollyGlot\\\"},{\\\"github\\\":\\\"\\\",\\\"link\\\":\\\"https://danielfreire.pages.dev/Miscellanea/DrumKit/\\\",\\\"src\\\":\\\"/images/screenshots/drumsVeryBig1920.webp\\\",\\\"summary\\\":\\\"Fun project to reproduce a Drum Kit in your PC.\\\",\\\"title\\\":\\\"drum kit app\\\"},{\\\"github\\\":\\\"\\\",\\\"link\\\":\\\"https://tenzi-bydaniel.netlify.app/\\\",\\\"src\\\":\\\"/images/screenshots/Tenzi.webp\\\",\\\"summary\\\":\\\"The world's most popular dice game, now in your browser.\\\",\\\"title\\\":\\\"tenzi\\\"}],\\\"projects-title\\\":\\\"Projects\\\",\\\"websites\\\":[{\\\"github\\\":\\\"\\\",\\\"link\\\":\\\"https://muraryu.com\\\",\\\"src\\\":\\\"/images/screenshots/muraryu.webp\\\",\\\"summary\\\":\\\"MuraRyu is a new Condominium Management company in Portugal.\\\",\\\"title\\\":\\\"muraRyu\\\"},{\\\"github\\\":\\\"\\\",\\\"link\\\":\\\"https://victo.pages.dev\\\",\\\"src\\\":\\\"/images/screenshots/victo.webp\\\",\\\"summary\\\":\\\"Gallery website built to showcase the works of the famous Portuguese artist Victó.\\\",\\\"title\\\":\\\"victó's art gallery\\\"},{\\\"github\\\":\\\"\\\",\\\"link\\\":\\\"https://insurbia.com\\\",\\\"src\\\":\\\"/images/screenshots/insurbia2.webp\\\",\\\"summary\\\":\\\"Website developed to be be contact point for the arquitecture collective Insurbia.\\\",\\\"title\\\":\\\"insurbia\\\"}],\\\"websites-title\\\":\\\"Websites\\\"},\\\"privacyPolicy\\\":{\\\"contactEmail\\\":\\\"gdpr@daniel-freire.com\\\",\\\"header1\\\":\\\"1. Einleitung\\\",\\\"header10\\\":\\\"10. Aktualisierungen dieser Datenschutzerklärung\\\",\\\"header11\\\":\\\"11. Kontaktieren Sie uns\\\",\\\"header2\\\":\\\"2. Informationen, die wir sammeln\\\",\\\"header3\\\":\\\"3. Zweck der Datenerhebung\\\",\\\"header4\\\":\\\"4. Rechtsgrundlage für die Verarbeitung\\\",\\\"header5\\\":\\\"5. Weitergabe personenbezogener Daten\\\",\\\"header6\\\":\\\"6. Aufbewahrung von Daten\\\",\\\"header7\\\":\\\"7. Ihre Rechte\\\",\\\"header8\\\":\\\"8. Datensicherheit\\\",\\\"header9\\\":\\\"9. Beschwerden\\\",\\\"paragraph1\\\":\\\"Willkommen auf der Website von Daniel Freire. Wir sind bestrebt, Ihre persönlichen Informationen und Ihr Recht auf Privatsphäre zu schützen. Wenn Sie Fragen oder Bedenken zu dieser Datenschutzerklärung oder unseren Praktiken in Bezug auf Ihre persönlichen Informationen haben, kontaktieren Sie uns bitte unter\\\",\\\"paragraph10\\\":\\\"Wir können diese Datenschutzerklärung von Zeit zu Zeit aktualisieren. Wir werden Sie über etwaige Änderungen informieren, indem wir die neue Datenschutzerklärung auf dieser Seite veröffentlichen.\\\",\\\"paragraph11\\\":\\\"Wenn Sie Fragen zu dieser Datenschutzerklärung haben, kontaktieren Sie uns bitte unter\\\",\\\"paragraph2\\\":\\\"Wir sammeln persönliche Informationen, die Sie uns freiwillig zur Verfügung stellen, wenn Sie ein Formular auf unserer Website ausfüllen. Die von uns gesammelten persönlichen Informationen umfassen:\\\",\\\"paragraph2li\\\":[\\\"Vorname\\\",\\\"Nachname\\\",\\\"E-Mail-Adresse\\\",\\\"Telefonnummer\\\"],\\\"paragraph3\\\":\\\"Die von uns gesammelten Informationen werden verwendet, um Sie in Zukunft zu kontaktieren. Wir werden Ihre personenbezogenen Daten nur für diesen spezifischen Zweck verwenden.\\\",\\\"paragraph4\\\":\\\"Wir verarbeiten Ihre personenbezogenen Daten auf der Grundlage Ihrer Einwilligung, die Sie durch das Ausfüllen des Formulars auf unserer Website erteilen.\\\",\\\"paragraph5\\\":\\\"Wir geben Ihre personenbezogenen Daten nicht an Dritte weiter, es sei denn, dies ist gesetzlich vorgeschrieben.\\\",\\\"paragraph6\\\":\\\"Wir bewahren Ihre personenbezogenen Daten nur so lange auf, wie es zur Erfüllung der Zwecke, für die wir sie erhoben haben, einschließlich zur Erfüllung gesetzlicher Anforderungen, erforderlich ist.\\\",\\\"paragraph7\\\":\\\"Sie haben das Recht:\\\",\\\"paragraph7li\\\":[\\\"Auf Zugang zu Ihren personenbezogenen Daten\\\",\\\"Auf Berichtigung Ihrer personenbezogenen Daten\\\",\\\"Auf Löschung Ihrer personenbezogenen Daten\\\",\\\"Widerspruch gegen die Verarbeitung Ihrer personenbezogenen Daten einzulegen\\\",\\\"Auf Einschränkung der Verarbeitung Ihrer personenbezogenen Daten\\\",\\\"Auf Übertragbarkeit Ihrer personenbezogenen Daten\\\",\\\"Ihre Einwilligung jederzeit zu widerrufen\\\"],\\\"paragraph8\\\":\\\"Wir setzen angemessene technische und organisatorische Maßnahmen um, um ein der Risikolage angemessenes Schutzniveau bei der Verarbeitung Ihrer personenbezogenen Daten zu gewährleisten.\\\",\\\"paragraph9\\\":\\\"Wenn Sie der Ansicht sind, dass wir die Datenschutzgesetze nicht eingehalten haben, haben Sie das Recht, Beschwerde bei der zuständigen Aufsichtsbehörde einzureichen.\\\",\\\"title\\\":\\\"Datenschutzerklärung für die Website von Daniel Freire\\\"},\\\"services\\\":[{\\\"icon\\\":\\\"/images/icons/business-processes.svg\\\",\\\"text\\\":\\\"Maßgeschneiderte Webanwendungen — CRMs, Dashboards und interne Tools, die zu Ihren Geschäftsprozessen passen.\\\",\\\"title\\\":\\\"Maßgeschneiderte Unternehmenssoftware\\\"},{\\\"icon\\\":\\\"/images/icons/ai-recommend.svg\\\",\\\"text\\\":\\\"Integration von KI in Ihre Arbeitsabläufe — Chatbots, intelligente Automatisierung und datengesteuerte Funktionen.\\\",\\\"title\\\":\\\"Implementierung von KI-Lösungen\\\"},{\\\"icon\\\":\\\"/images/icons/dns-services.svg\\\",\\\"text\\\":\\\"Moderne, leistungsstarke Websites und Anwendungen mit React, Next.js und TypeScript.\\\",\\\"title\\\":\\\"Webentwicklung\\\"},{\\\"icon\\\":\\\"/images/icons/ibm-watson--machine-learning.svg\\\",\\\"text\\\":\\\"Datengestützte Audits, Performance-Optimierung und Strategie, damit Ihr Unternehmen gefunden wird.\\\",\\\"title\\\":\\\"SEO \\u0026 Technische Beratung\\\"}],\\\"sidenav\\\":{\\\"footer\\\":{\\\"blurb\\\":\\\"Gemacht mit 🐞 von\\\",\\\"icons\\\":{\\\"github\\\":{\\\"alt\\\":\\\"GitHub\\\",\\\"ariaDetails\\\":\\\"Daniel Freires GitHub\\\",\\\"ariaLAbel\\\":\\\"Daniel Freires GitHub\\\",\\\"link\\\":\\\"https://github.com/danielfreire-dev/\\\",\\\"src\\\":\\\"/images/icons/github-square.svg\\\",\\\"title\\\":\\\"Daniel Freires GitHub\\\"},\\\"linkedin\\\":{\\\"alt\\\":\\\"LinkedIn\\\",\\\"ariaDetails\\\":\\\"Daniel Freires LinkedIn\\\",\\\"ariaLAbel\\\":\\\"Daniel Freires LinkedIn\\\",\\\"link\\\":\\\"https://www.linkedin.com/in/danielfreire-swe/\\\",\\\"src\\\":\\\"/images/icons/linkedin.svg\\\",\\\"title\\\":\\\"Daniel Freires LinkedIn\\\"}}},\\\"header\\\":{\\\"role\\\":\\\"webentwickler\\\",\\\"title\\\":\\\"daniel freire\\\"},\\\"legal\\\":{\\\"impressumLink\\\":\\\"/impressum\\\",\\\"impressumName\\\":\\\"impressum\\\",\\\"privacyLink\\\":\\\"/datenschutz\\\",\\\"privacyLinkAriaDetails\\\":\\\"Datenschutzerklärung\\\",\\\"privacyLinkAriaLabel\\\":\\\"Datenschutzerklärung\\\",\\\"privacyLinkTitle\\\":\\\"Datenschutzerklärung\\\",\\\"privacyName\\\":\\\"datenschutzerklärung\\\"},\\\"links\\\":[{\\\"link\\\":\\\"/\\\",\\\"name\\\":\\\"startseite\\\"},{\\\"link\\\":\\\"/ueber-mich\\\",\\\"name\\\":\\\"über mich\\\"},{\\\"link\\\":\\\"/portfolio\\\",\\\"name\\\":\\\"portfolio\\\"},{\\\"link\\\":\\\"/kontakt\\\",\\\"name\\\":\\\"kontakt\\\"}],\\\"privacy\\\":\\\"datenschutzerklärung\\\",\\\"rights\\\":\\\"Daniel Freire ® alle Rechte vorbehalten\\\",\\\"select\\\":{\\\"languageSelectAriaLabel\\\":\\\"Sprachauswahlmenü\\\",\\\"languageSelectTitle\\\":\\\"Sprachauswahlmenü\\\"}},\\\"tech\\\":[{\\\"link\\\":\\\"https://nextjs.org\\\",\\\"logo\\\":\\\"/images/icons/nextjs-13.svg\\\",\\\"name\\\":\\\"next.js\\\",\\\"svgr\\\":\\\"Nextjs\\\"},{\\\"link\\\":\\\"https://react.dev\\\",\\\"logo\\\":\\\"/images/icons/react2.svg\\\",\\\"name\\\":\\\"react.js\\\",\\\"svgr\\\":\\\"Reactjs\\\"},{\\\"link\\\":\\\"https://nodejs.org/en\\\",\\\"logo\\\":\\\"/images/icons/node-js.svg\\\",\\\"name\\\":\\\"node.js\\\",\\\"svgr\\\":\\\"Nodejs\\\"},{\\\"link\\\":\\\"https://www.typescriptlang.org\\\",\\\"logo\\\":\\\"/images/icons/Typescript.svg\\\",\\\"name\\\":\\\"typeScript\\\",\\\"svgr\\\":\\\"TypeScript\\\"},{\\\"link\\\":\\\"https://developer.mozilla.org/en-US/docs/Web/JavaScript\\\",\\\"logo\\\":\\\"/images/icons/javascript-original.svg\\\",\\\"name\\\":\\\"javaScript\\\",\\\"svgr\\\":\\\"JavaScript\\\"},{\\\"link\\\":\\\"https://www.w3.org/html/\\\",\\\"logo\\\":\\\"/images/icons/html5-original-wordmark.svg\\\",\\\"name\\\":\\\"HTML5\\\",\\\"svgr\\\":\\\"HTML5\\\"},{\\\"link\\\":\\\"https://developer.mozilla.org/en-US/docs/Web/CSS\\\",\\\"logo\\\":\\\"/images/icons/Official_CSS_Logo.svg\\\",\\\"name\\\":\\\"CSS3\\\",\\\"svgr\\\":\\\"CSS3\\\"},{\\\"link\\\":\\\"https://www.postgresql.org\\\",\\\"logo\\\":\\\"/images/icons/postgresql.svg\\\",\\\"name\\\":\\\"postgreSQL\\\",\\\"svgr\\\":\\\"PostgreSQL\\\"},{\\\"link\\\":\\\"https://vite.dev\\\",\\\"logo\\\":\\\"/images/icons/vitejs.svg\\\",\\\"name\\\":\\\"vite.js\\\",\\\"svgr\\\":\\\"Vitejs\\\"},{\\\"link\\\":\\\"https://webpack.js.org/\\\",\\\"logo\\\":\\\"/images/icons/webpack.svg\\\",\\\"name\\\":\\\"webpack\\\",\\\"svgr\\\":\\\"Webpack\\\"},{\\\"link\\\":\\\"https://github.com/\\\",\\\"logo\\\":\\\"/images/icons/github.svg\\\",\\\"name\\\":\\\"gitHub\\\",\\\"svgr\\\":\\\"Github\\\"},{\\\"link\\\":\\\"https://git-scm.com/\\\",\\\"logo\\\":\\\"/images/icons/git-scm-icon.svg\\\",\\\"name\\\":\\\"git\\\",\\\"svgr\\\":\\\"Git\\\"},{\\\"link\\\":\\\"https://vitest.dev/\\\",\\\"logo\\\":\\\"/images/icons/vitest.svg\\\",\\\"name\\\":\\\"vitest\\\",\\\"svgr\\\":\\\"Vitest\\\"},{\\\"link\\\":\\\"https://jestjs.io/\\\",\\\"logo\\\":\\\"/images/icons/jestjsio-icon.svg\\\",\\\"name\\\":\\\"jest\\\",\\\"svgr\\\":\\\"Jest\\\"},{\\\"link\\\":\\\"https://selenium-python.readthedocs.io/\\\",\\\"logo\\\":\\\"/images/icons/selenium.svg\\\",\\\"name\\\":\\\"selenium\\\",\\\"svgr\\\":\\\"Selenium\\\"},{\\\"link\\\":\\\"https://www.python.org/\\\",\\\"logo\\\":\\\"/images/icons/python-original.svg\\\",\\\"name\\\":\\\"python\\\",\\\"svgr\\\":\\\"Python\\\"},{\\\"link\\\":\\\"https://www.linux.org/\\\",\\\"logo\\\":\\\"/images/icons/linux-original.svg\\\",\\\"name\\\":\\\"linux\\\",\\\"svgr\\\":\\\"Linux\\\"}],\\\"topMainPage\\\":{\\\"blurbsArray\\\":[{\\\"description\\\":\\\"Bremst Ihre Website Ihr Geschäftswachstum aus? Unser umfassender Performance-Audit analysiert tiefgehend Ihre technische Infrastruktur, Benutzererfahrung und Ihr Conversion-Potenzial. Wir liefern Ihnen einen detaillierten Bericht mit entscheidenden Verbesserungen, die Ihre Online-Performance dramatisch steigern können.\\\",\\\"title\\\":\\\"Revolutionieren Sie jetzt Ihre digitale Präsenz!\\\"},{\\\"description\\\":\\\"Websites benötigen ständige Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problemlösung und kontinuierliche technologische Updates.\\\",\\\"title\\\":\\\"Schöpfen Sie das volle Potenzial Ihrer Website aus\\\"},{\\\"description\\\":\\\"Geben Sie sich nicht länger mit generischen Vorlagen zufrieden. Unsere maßgeschneiderten Webentwicklungsdienste schaffen vollständig angepasste digitale Erlebnisse, die perfekt mit der einzigartigen Identität Ihrer Marke und Ihren Geschäftszielen übereinstimmen. Wir verwandeln Ihr Konzept in eine leistungsstarke, responsive und zukunftsweisende Weblösung.\\\",\\\"title\\\":\\\"Verwirklichen Sie noch heute Ihr Traumprojekt\\\"},{\\\"description\\\":\\\"Geschwindigkeit ist nicht nur ein Feature – sie ist ein Wettbewerbsvorteil. Unser Service zur Leistungsoptimierung sorgt für extrem schnelles Laden Ihrer Website und bietet eine außergewöhnliche Benutzererfahrung, die Besucher bindet und effektiver zu Konversionen führt.\\\",\\\"title\\\":\\\"Beschleunigen Sie das Potenzial Ihrer Website\\\"},{\\\"description\\\":\\\"Die Technologie entwickelt sich rasant weiter. Unsere spezialisierten Migrationsdienste helfen Ihnen beim nahtlosen Übergang zu modernen, effizienten Webtechnologien, ohne Ihren laufenden Betrieb zu stören. Wir gewährleisten einen reibungslosen, risikomanagerten Upgrade-Pfad.\\\",\\\"title\\\":\\\"Modernisieren Sie Ihre digitale Infrastruktur\\\"},{\\\"description\\\":\\\"Websites benötigen ständige Pflege, um sicher, funktional und wettbewerbsfähig zu bleiben. Unsere umfassenden Wartungspakete bieten proaktives Monitoring, sofortige Problemlösung und kontinuierliche technologische Updates.\\\",\\\"title\\\":\\\"Laufende Betreuung Ihrer digitalen Assets\\\"}],\\\"p1\\\":\\\"Haben Sie es satt, dass Software Ihr Geschäft ausbremst?\\\",\\\"p2\\\":\\\"Die meisten Geschäftsanwendungen sind entweder zu starr oder zu komplex. Ich spezialisiere mich auf die Entwicklung maßgeschneiderter Webanwendungen – wie CRM-Systeme, Projekt-Tracker und Daten-Dashboards – die genau zu Ihrer tatsächlichen Arbeitsweise passen. Wenn Sie ein Werkzeug benötigen, das ein bestimmtes Problem ohne überflüssige Funktionen löst, sprechen wir darüber, was Sie erreichen möchten.\\\"}},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"Europe/Lisbon\\\",\\\"children\\\":\\\"$L15\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"16:I[59,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"Providers\\\"]\\n17:I[5564,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"908\\\",\\\"static/chunks/908-6bb2778964e2ca03.js\\\",\\\"51\\\",\\\"static/chunks/51-063b24f715f61199.js\\\",\\\"261\\\",\\\"static/chunks/261-e6773460e5f3e14a.js\\\",\\\"450\\\",\\\"static/chunks/app/%5Blocale%5D/layout-6b5f594b50a93f99.js\\\"],\\\"default\\\"]\\n18:I[4275,[\\\"694\\\",\\\"static/chunks/694-009548b009ecd054.js\\\",\\\"530\\\",\\\"static/chunks/app/%5Blocale%5D/error-8ecce493219f8816.js\\\"],\\\"default\\\"]\\n15:[\\\"$\\\",\\\"$L16\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"flex flex-row\\\",\\\"children\\\":[\\\"$\\\",\\\"$L17\\\",null,{}]}],[\\\"$\\\",\\\"main\\\",null,{\\\"className\\\":\\\"flex flex-1 justify-center flex-col overflow-hidden pb-5 mt-9\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"id\\\":\\\"main\\\",\\\"children\\\":[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$18\\\",\\\"errorStyles\\\":[],\\\"errorScripts\\\":[],\\\"template\\\":[\\\"$\\\",\\\"$L3\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n7:null\\n\"])</script><script>self.__next_f.push([1,\"19:I[3407,[],\\\"IconMark\\\"]\\n\"])</script><script>self.__next_f.push([1,\"9:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Kontakt | Daniel Freire\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Dies ist der beste Ort, um Daniel zu kontaktieren\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"author\\\",\\\"href\\\":\\\"https://daniel-freire.com/\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"Daniel Freire\\\"}],[\\\"$\\\",\\\"link\\\",\\\"4\\\",{\\\"rel\\\":\\\"manifest\\\",\\\"href\\\":\\\"/manifest.webmanifest\\\",\\\"crossOrigin\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"Daniel Freire,Portfolio,Next.js,React,TypeScript,JavaScript,Digital Marketing\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"Daniel Freire\\\"}],[\\\"$\\\",\\\"link\\\",\\\"7\\\",{\\\"rel\\\":\\\"canonical\\\",\\\"href\\\":\\\"https://daniel-freire.com/contact\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"alternate\\\",\\\"hrefLang\\\":\\\"en\\\",\\\"href\\\":\\\"https://daniel-freire.com/en/contact\\\"}],[\\\"$\\\",\\\"link\\\",\\\"9\\\",{\\\"rel\\\":\\\"alternate\\\",\\\"hrefLang\\\":\\\"pt\\\",\\\"href\\\":\\\"https://daniel-freire.com/pt/contactos\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"name\\\":\\\"format-detection\\\",\\\"content\\\":\\\"telephone=no, address=no, email=no\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Daniel Freire\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"property\\\":\\\"og:description\\\",\\\"content\\\":\\\"Dies ist der beste Ort, um Daniel zu kontaktieren\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"property\\\":\\\"og:url\\\",\\\"content\\\":\\\"https://daniel-freire.com\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"property\\\":\\\"og:site_name\\\",\\\"content\\\":\\\"Kontakt\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"de\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"16\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://daniel-freire.com/metadata/open-graph-initials5.png\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"17\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"18\