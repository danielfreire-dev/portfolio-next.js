# This file is AUTO-GENERATED from .env by `npm run sync:env`.
# You should NOT edit it manually — edit .env instead.
#
# Listed here for reference so contributors know which variables
# are available in the Cloudflare/Wrangler environment.
#
# NEVER commit .dev.vars — it contains secrets and is gitignored.

NEXTJS_ENV

# Resend API key for email sending
NEXT_PUBLIC_resend
# Email address for contact form submissions
NEXT_PUBLIC_dataEmail

NEXT_PUBLIC_VERCEL_URL

# Cloudflare Turnstile — bot protection for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Cloudflare Turnstile — server-side verification secret (private, never exposed to client)
TURNSTILE_SECRET_KEY

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4
