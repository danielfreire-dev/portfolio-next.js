
# Environment variables for Next.js.
# Copy this file to .env and fill in the values.
#
# NEVER commit .env — it contains secrets and is gitignored.
#
# Naming conventions:
#   NEXT_PUBLIC_* — inlined at build time, visible to client-side JS.
#                    Only use for truly public values (site keys, analytics IDs).
#   Everything else — server-only, never exposed to the browser.
#                    Use for API keys, secrets, and internal config.

# Resend API key for email sending (server-only — do NOT prefix with NEXT_PUBLIC_)
RESEND_API_KEY
# Email address for contact form submissions (server-only)
DATA_EMAIL

# Turnstile — bot protection for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Turnstile — server-side verification secret (private, never exposed to client)
TURNSTILE_SECRET_KEY

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4
