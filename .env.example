
# Environment variables for Next.js.
# Copy this file to .env and fill in the values.
#
# NEVER commit .env — it contains secrets and is gitignored.

# Resend API key for email sending
NEXT_PUBLIC_RESEND
# Email address for contact form submissions
NEXT_PUBLIC_DATA_EMAIL

# Turnstile — bot protection for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY
# Turnstile — server-side verification secret (private, never exposed to client)
TURNSTILE_SECRET_KEY

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4
